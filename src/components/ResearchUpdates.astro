---
import { withBase } from '../lib/site-config';

type Kind = 'model' | 'paper' | 'blog';

interface Entry {
  kind: Kind;
  id: string;
  data: {
    title: string;
    shortTitle?: string;
    date: Date;
  };
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
const base = import.meta.env.BASE_URL;
const pathByKind: Record<Kind, string> = { model: 'models', paper: 'papers', blog: 'blog' };
const labelByKind: Record<Kind, string> = { model: 'Model', paper: 'Paper', blog: 'Note' };
---

<section class="research-updates shell" data-research-updates aria-labelledby="research-updates-title">
  <h2 id="research-updates-title">Research updates</h2>
  <div class="updates-grid">
    {entries.map((entry) => (
      <a
        href={withBase(base, `${pathByKind[entry.kind]}/${entry.id}/`)}
        data-update-entry
      >
        <span class="update-meta">
          <span class="update-kind">{labelByKind[entry.kind]}</span>
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: '2-digit',
            })}
          </time>
        </span>
        <strong class="update-title">{entry.data.shortTitle ?? entry.data.title}</strong>
        <span class="update-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>

<style>
  .research-updates {
    padding-top: clamp(1.4rem, 2.2vw, 2rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  h2 {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--type-meta);
    font-weight: 500;
    line-height: var(--leading-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .updates-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-3);
    min-width: 0;
    min-height: 7.25rem;
    padding: var(--space-2) var(--space-4) var(--space-2) 0;
    border-top: 1px solid var(--line);
  }

  a:nth-child(even) {
    padding-right: 0;
    padding-left: 2.25rem;
    border-left: 1px solid var(--line);
  }

  .update-meta {
    display: flex;
    grid-column: 1 / -1;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--type-meta);
    line-height: var(--leading-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .update-title {
    min-width: 0;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: var(--text-title-sm);
    font-weight: 500;
    line-height: var(--leading-title-sm);
    letter-spacing: var(--tracking-title);
    text-wrap: balance;
  }

  .update-arrow {
    align-self: end;
    color: var(--muted);
    font-size: var(--text-small);
    transition: color 180ms ease, transform 180ms ease;
  }

  a:hover .update-arrow,
  a:focus-visible .update-arrow {
    color: var(--ink);
    transform: translate(2px, -2px);
  }

  a:focus-visible {
    outline: 1px solid var(--ink-soft);
    outline-offset: -1px;
  }

  @media (max-width: 700px) {
    .research-updates {
      padding-top: 1.25rem;
    }

    .updates-grid {
      grid-template-columns: 1fr;
    }

    a,
    a:nth-child(even) {
      min-height: 6.5rem;
      padding: 1rem 0 1.15rem;
      border-left: 0;
    }

    .update-title {
      font-size: var(--text-body);
      text-wrap: pretty;
    }
  }
</style>

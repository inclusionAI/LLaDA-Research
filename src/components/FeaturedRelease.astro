---
import { withBase } from '../lib/site-config';

type Kind = 'model' | 'paper' | 'blog';

interface Entry {
  kind: Kind;
  id: string;
  data: {
    title: string;
    summary: string;
    date: Date;
  };
}

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const pathByKind: Record<Kind, string> = { model: 'models', paper: 'papers', blog: 'blog' };
const detailUrl = withBase(base, `${pathByKind[entry.kind]}/${entry.id}/`);
const formattedDate = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<aside class="featured-strip shell" data-featured-strip aria-label={`Featured ${entry.kind}`}>
  <a href={detailUrl}>
    <span class="featured-label">Featured / 01</span>
    <span class="featured-title">
      <strong>{entry.data.title}</strong>
      <span class="featured-kind">{entry.kind}</span>
    </span>
    <span class="featured-end">
      <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
      <span class="featured-arrow" aria-hidden="true">↗</span>
    </span>
  </a>
</aside>

<style>
  .featured-strip {
    min-height: 47px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    border-radius: 0;
  }

  a {
    display: grid;
    grid-template-columns: minmax(7rem, 0.35fr) minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    min-height: 47px;
  }

  .featured-label,
  .featured-kind,
  .featured-end {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-title {
    display: flex;
    min-width: 0;
    gap: 0.8rem;
    align-items: baseline;
    transition: transform 180ms ease;
  }

  .featured-title strong {
    overflow: hidden;
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 520;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .featured-end {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .featured-arrow {
    color: var(--ink-soft);
    font-size: 0.8rem;
    transition: color 180ms ease, transform 180ms ease;
  }

  a:hover .featured-title {
    transform: translateX(5px);
  }

  a:hover .featured-arrow {
    color: var(--ink);
    transform: translate(2px, -2px);
  }

  @media (max-width: 700px) {
    a {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .featured-label {
      font-size: 0;
    }

    .featured-label::after {
      font-size: 0.56rem;
      content: 'F / 01';
    }

    .featured-kind,
    .featured-end time {
      display: none;
    }
  }
</style>

---
import { withBase } from '../lib/site-config';

type Kind = 'model' | 'paper' | 'blog';

interface Entry {
  id: string;
  data: {
    title: string;
    summary: string;
    date: Date;
    tags: string[];
    modality?: string;
    venue?: string;
    category?: string;
  };
}

interface Props {
  kind: Kind;
  title: string;
  href: string;
  entries: Entry[];
}

const { kind, title, href, entries } = Astro.props;
const base = import.meta.env.BASE_URL;
const route = kind === 'blog' ? 'blog' : `${kind}s`;
const metaFor = (entry: Entry) => {
  if (kind === 'model') return entry.data.modality ?? 'Model';
  if (kind === 'paper') return entry.data.venue ?? 'Paper';
  return entry.data.category ?? 'Field note';
};
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<section class="research-column" aria-labelledby={`${kind}-title`}>
  <header class="column-header">
    <div>
      <span class="column-index">0{kind === 'model' ? 1 : kind === 'paper' ? 2 : 3}</span>
      <h2 id={`${kind}-title`}>{title}</h2>
    </div>
    <span class="entry-count">{entries.length.toString().padStart(2, '0')}</span>
  </header>
  <ol>
    {entries.map((entry) => (
      <li>
        <a class="entry-link" href={withBase(base, `${route}/${entry.id}/`)}>
          <div class="entry-meta">
            <span>{metaFor(entry)}</span>
            <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          </div>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary}</p>
          <span class="entry-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
  <a class="view-all" href={withBase(base, href)}>All {title.toLowerCase()} <span aria-hidden="true">→</span></a>
</section>

<style>
  .research-column {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.5rem 1.4rem 1.1rem;
  }

  .research-column:first-child {
    padding-left: 0;
  }

  .research-column:last-child {
    padding-right: 0;
  }

  .column-header,
  .column-header > div {
    display: flex;
    align-items: baseline;
  }

  .column-header {
    justify-content: space-between;
    padding-bottom: 1.25rem;
  }

  .column-header > div {
    gap: 0.65rem;
  }

  .column-index,
  .entry-count {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.55rem;
    letter-spacing: 0.1em;
  }

  h2 {
    margin: 0;
    font-size: 1.28rem;
    font-weight: 480;
    letter-spacing: -0.045em;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-top: 1px solid var(--line);
  }

  .entry-link {
    position: relative;
    display: block;
    min-height: 10.2rem;
    padding: 1.2rem 2rem 1.2rem 0;
  }

  .entry-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .entry-meta span:first-child {
    color: var(--ink-soft);
  }

  h3 {
    margin: 0.7rem 0 0.6rem;
    font-size: 1rem;
    font-weight: 510;
    line-height: 1.25;
    letter-spacing: -0.025em;
    transition: color 180ms ease, transform 180ms ease;
  }

  p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .entry-arrow {
    position: absolute;
    top: 1.15rem;
    right: 0;
    color: var(--line-strong);
    transition: color 180ms ease, transform 180ms ease;
  }

  .entry-link:hover h3 {
    color: var(--ink);
    transform: translateX(4px);
  }

  .entry-link:hover .entry-arrow {
    color: var(--ink);
    transform: translate(2px, -2px);
  }

  .view-all {
    display: flex;
    justify-content: space-between;
    margin-top: auto;
    padding: 1rem 0 0.1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .research-column,
    .research-column:first-child,
    .research-column:last-child {
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--line);
    }

    .entry-link {
      min-height: auto;
    }
  }
</style>

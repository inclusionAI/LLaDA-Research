---
import { withBase } from '../lib/site-config';

type Kind = 'model' | 'paper' | 'blog';

interface Entry {
  id: string;
  data: {
    title: string;
    summary: string;
    date: Date;
    tags: string[];
    modality?: string;
    venue?: string;
    category?: string;
  };
}

interface Props {
  kind: Kind;
  title: string;
  description: string;
  ctaLabel: string;
  href: string;
  entries: Entry[];
}

const { kind, title, description, ctaLabel, href, entries } = Astro.props;
const base = import.meta.env.BASE_URL;
const route = kind === 'blog' ? 'blog' : `${kind}s`;
const tokenFor: Record<Kind, string> = {
  model: '[MODEL]',
  paper: '[PAPER]',
  blog: '[NOTE]',
};
const metaFor = (entry: Entry) => {
  if (kind === 'model') return entry.data.modality ?? 'Model';
  if (kind === 'paper') return entry.data.venue ?? 'Paper';
  return entry.data.category ?? 'Field note';
};
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<section class="research-column" data-research-column aria-labelledby={`${kind}-title`}>
  <header class="column-header">
    <h2 id={`${kind}-title`}>{title}</h2>
    <p>{description}</p>
  </header>
  <ol>
    {entries.map((entry, index) => (
      <li data-entry-kind={index === 0 ? 'lead' : 'compact'}>
        <a
          class:list={['entry-link', index === 0 ? 'entry-link--lead' : 'entry-link--compact']}
          href={withBase(base, `${route}/${entry.id}/`)}
        >
          <div class="entry-meta">
            <span>{metaFor(entry)}</span>
            <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          </div>
          <h3>{entry.data.title}</h3>
          {index === 0 && (
            <>
              <p>{entry.data.summary}</p>
              <span class="entry-token" aria-hidden="true">
                <span class="token-mask">[MASK]</span>
                <span class="token-kind">{tokenFor[kind]}</span>
              </span>
            </>
          )}
          <span class="entry-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
  <a class="view-all" href={withBase(base, href)}>{ctaLabel} <span aria-hidden="true">→</span></a>
</section>

<style>
  .research-column {
    min-width: 0;
  }

  .column-header {
    padding-bottom: 1.8rem;
  }

  h2 {
    margin: 0;
    font-size: 1.28rem;
    font-weight: 480;
    letter-spacing: -0.045em;
  }

  .column-header p {
    max-width: 25rem;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.73rem;
    line-height: 1.55;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 1.35rem;
  }

  .entry-link {
    position: relative;
    display: block;
    overflow: hidden;
    padding: 0.65rem 2rem 0.65rem 0;
    isolation: isolate;
  }

  .entry-link::before {
    position: absolute;
    z-index: -1;
    inset: -50% -10%;
    background: radial-gradient(circle at 18% 50%, rgb(255 255 255 / 0.035), transparent 48%);
    content: '';
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .entry-link:hover::before {
    opacity: 1;
  }

  .entry-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .entry-meta span:first-child {
    color: var(--ink-soft);
  }

  h3 {
    margin: 0.7rem 0 0;
    font-weight: 510;
    line-height: 1.25;
    letter-spacing: -0.025em;
    transition: color 180ms ease, transform 180ms ease;
  }

  .entry-link--lead h3 {
    font-size: clamp(1.2rem, 1.55vw, 1.38rem);
  }

  .entry-link--compact h3 {
    font-size: clamp(0.88rem, 1.05vw, 1rem);
  }

  .entry-link > p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .entry-arrow {
    position: absolute;
    top: 1.15rem;
    right: 0;
    color: var(--line-strong);
    transition: color 180ms ease, transform 180ms ease;
  }

  .entry-link:hover h3 {
    color: var(--ink);
    transform: translateY(-3px);
  }

  .entry-link:hover .entry-arrow {
    color: var(--ink);
    transform: translate(2px, -2px);
  }

  .entry-token {
    position: relative;
    display: inline-grid;
    margin-top: 1rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.54rem;
    letter-spacing: 0.08em;
  }

  .entry-token > span {
    grid-area: 1 / 1;
    transition: opacity 180ms ease;
  }

  .token-kind {
    color: var(--ink-soft);
    opacity: 0;
  }

  .entry-link:hover .token-mask {
    opacity: 0;
  }

  .entry-link:hover .token-kind {
    opacity: 1;
  }

  .view-all {
    display: inline-flex;
    gap: 0.55rem;
    margin-top: 1.75rem;
    padding-bottom: 0.18rem;
    color: var(--ink-soft);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    background-image: linear-gradient(var(--line-strong), var(--line-strong));
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size 180ms ease, color 180ms ease;
  }

  .view-all:hover {
    color: var(--ink);
    background-size: 100% 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-link::before,
    h3,
    .entry-arrow,
    .entry-token > span,
    .view-all {
      transition: none;
    }

    .entry-link:hover h3,
    .entry-link:hover .entry-arrow {
      transform: none;
    }
  }
</style>

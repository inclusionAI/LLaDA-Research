---
interface Props {
  label?: string;
  compact?: boolean;
}

const { label = 'LLaDA diffusion field', compact = false } = Astro.props;
---

<figure class:list={['diffusion-mark', { compact }]} aria-label={label} role="img">
  <svg viewBox="0 0 640 480" aria-hidden="true">
    <circle cx="390" cy="222" r="208" fill="#eef3ed" />
    <g fill="none" stroke="#527a68">
      <circle cx="386" cy="231" r="80" />
      <circle cx="386" cy="231" r="122" opacity="0.68" />
      <circle cx="386" cy="231" r="166" opacity="0.42" />
      <ellipse cx="386" cy="231" rx="212" ry="112" transform="rotate(-18 386 231)" opacity="0.35" />
    </g>
    <g fill="#24312b">
      <circle cx="296" cy="169" r="4" />
      <circle cx="465" cy="128" r="3" opacity="0.7" />
      <circle cx="509" cy="283" r="5" opacity="0.65" />
      <circle cx="351" cy="347" r="3" opacity="0.6" />
    </g>
  </svg>
</figure>

<style>
  .diffusion-mark {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    min-height: 16rem;
    margin: 0;
    border: 1px solid var(--line);
    background: var(--paper);
  }

  svg {
    position: absolute;
    inset: -8% -4% -8% 1%;
    width: 108%;
    height: 116%;
    animation: drift 12s ease-in-out infinite alternate;
  }

  .compact {
    min-height: 10rem;
  }

  @keyframes drift {
    from { transform: scale(1) rotate(-1deg); }
    to { transform: scale(1.035) rotate(1deg); }
  }
</style>

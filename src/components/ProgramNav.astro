---
import { withBase } from '../lib/site-config';

const base = import.meta.env.BASE_URL;
const programs = [
  {
    title: 'Models',
    description: 'Open checkpoints and release details.',
    href: 'models/',
  },
  {
    title: 'Publications',
    description: 'Methods, results, and technical reports.',
    href: 'papers/',
  },
];
---

<section class="program-nav shell" aria-labelledby="program-nav-title">
  <h2 id="program-nav-title">Explore</h2>
  <nav aria-label="Research program">
    {programs.map((program) => (
      <a href={withBase(base, program.href)} data-program-link>
        <span class="program-title">{program.title}</span>
        <span class="program-description">{program.description}</span>
        <span class="program-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </nav>
</section>

<style>
  .program-nav {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) 1rem;
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-title-md);
    font-weight: 600;
    line-height: var(--leading-title-md);
    letter-spacing: var(--tracking-title);
  }

  nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "title arrow"
      "desc arrow";
    gap: var(--space-1) var(--space-2);
    min-height: 7rem;
    padding: var(--space-3) clamp(var(--space-2), 2.5vw, var(--space-4)) var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }

  .program-title {
    grid-area: title;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: var(--text-title-sm);
    font-weight: 500;
    line-height: var(--leading-title-sm);
    letter-spacing: var(--tracking-title);
  }

  .program-description {
    grid-area: desc;
    color: var(--muted);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  .program-arrow {
    grid-area: arrow;
    align-self: center;
    color: var(--muted);
    transition: color 180ms ease, transform 180ms ease;
  }

  a:hover .program-arrow,
  a:focus-visible .program-arrow {
    color: var(--ink);
    transform: translateX(3px);
  }

  @media (min-width: 701px) {
    a + a {
      padding-left: clamp(1rem, 2.5vw, 2rem);
      border-left: 1px solid var(--line);
    }
  }

  @media (max-width: 700px) {
    nav {
      grid-template-columns: 1fr;
    }

    a,
    a + a {
      padding: 1.25rem 0;
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .program-arrow {
      transition: none;
    }

    a:hover .program-arrow,
    a:focus-visible .program-arrow {
      transform: none;
    }
  }
</style>

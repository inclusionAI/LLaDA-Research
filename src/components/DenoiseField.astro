<div
  class="denoise-field"
  data-denoise-field
  data-visual-system="coherence-field"
  data-decode-window-ms="650"
  data-edit-mode="simultaneous"
  data-coherence-state="noise"
  data-motion="full"
  data-interacting="false"
  aria-hidden="true"
>
  <canvas></canvas>
  <div class="field-readout">
    <span>MASK / TOKEN</span>
    <span>PARALLEL DIFFUSION / EDITING</span>
  </div>
</div>

<script>
  import { densityForFps, tokenStageForInfluence } from '../lib/particle-field';

  type Particle = {
    x: number;
    y: number;
    originX: number;
    originY: number;
    depth: number;
    seed: number;
    size: number;
    glyphIndex: number;
  };

  const maskGlyphs = ['[MASK]', '[ · ]', '▧', '[  ]', '░'];
  const partialGlyphs = ['La', 'DA', 'tion', '∇x', 'lang', 'diff'];
  const resolvedGlyphs = ['LLaDA', 'language', 'token', 'parallel', 'diffusion'];

  document.querySelectorAll<HTMLElement>('[data-denoise-field]').forEach((field) => {
    const canvas = field.querySelector('canvas');
    const context = canvas?.getContext('2d', { alpha: true });
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!canvas || !context) return;

    const drawReducedSnapshot = () => {
      const bounds = field.getBoundingClientRect();
      const width = Math.max(1, bounds.width);
      const height = Math.max(1, bounds.height);
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, width, height);

      for (let index = 0; index < Math.round((width * height) / 310); index += 1) {
        const seed = (index * 73) % 997;
        const x = width * (0.4 + ((seed * 37) % 601) / 1000);
        const y = height * (0.18 + ((seed * 61) % 641) / 1000);
        const depth = (index % 3) / 2;
        context.fillStyle = `rgba(190, 195, 187, ${0.08 + depth * 0.1})`;
        context.fillRect(x, y, 0.5 + depth * 0.65, 0.5 + depth * 0.65);
      }

      context.font = '10px ui-monospace, SFMono-Regular, Menlo, monospace';
      context.fillStyle = 'rgba(232, 234, 226, 0.72)';
      context.fillText('[MASK]  language  diff·', width * 0.63, height * 0.44);
      context.fillText('parallel  [··]  token', width * 0.68, height * 0.53);
    };

    if (motionQuery.matches) {
      field.dataset.motion = 'reduced';
      field.dataset.coherenceState = 'partial';
      drawReducedSnapshot();
      return;
    }

    let width = 0;
    let height = 0;
    let devicePixelRatio = 1;
    let density = window.matchMedia('(max-width: 700px)').matches ? 0.55 : 1;
    let particles: Particle[] = [];
    let frameHandle = 0;
    let frameCount = 0;
    let frameWindowStarted = performance.now();
    let previousFrame = frameWindowStarted;
    let interactionTimer = 0;
    const pointer = { x: 0, y: 0, previousX: 0, previousY: 0, speed: 0, active: false, energy: 0 };

    const makeParticle = (index: number): Particle => {
      const band = index % 5;
      const centerY = height * (0.27 + band * 0.115);
      const x = width * (0.42 + Math.random() * 0.57);
      const y = centerY + (Math.random() + Math.random() - 1) * height * 0.085;

      return {
        x,
        y,
        originX: x,
        originY: y,
        depth: Math.random(),
        seed: Math.random() * 1000,
        size: 0.28 + Math.random() * 1.15,
        glyphIndex: index,
      };
    };

    const rebuildParticles = () => {
      const particleCount = Math.round((width * height) / 165 * density);
      particles = Array.from({ length: particleCount }, (_, index) => makeParticle(index));
    };

    const resize = () => {
      const bounds = field.getBoundingClientRect();
      width = Math.max(1, bounds.width);
      height = Math.max(1, bounds.height);
      devicePixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * devicePixelRatio);
      canvas.height = Math.round(height * devicePixelRatio);
      context.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
      rebuildParticles();
    };

    const markInteraction = () => {
      field.dataset.interacting = 'true';
      window.clearTimeout(interactionTimer);
      interactionTimer = window.setTimeout(() => {
        field.dataset.interacting = 'false';
      }, 1100);
    };

    const updatePointer = (event: PointerEvent) => {
      const bounds = field.getBoundingClientRect();
      const nextX = event.clientX - bounds.left;
      const nextY = event.clientY - bounds.top;
      pointer.speed = Math.min(42, Math.hypot(nextX - pointer.x, nextY - pointer.y));
      pointer.previousX = pointer.x || nextX;
      pointer.previousY = pointer.y || nextY;
      pointer.x = nextX;
      pointer.y = nextY;
      pointer.active = true;
      pointer.energy = Math.min(1, pointer.energy + 0.2);
      markInteraction();
    };

    field.addEventListener('pointerenter', updatePointer);
    field.addEventListener('pointermove', updatePointer);
    field.addEventListener('pointerleave', () => {
      pointer.active = false;
      markInteraction();
    });

    const drawGlyph = (particle: Particle, influence: number, x: number, y: number, alpha: number) => {
      const stage = tokenStageForInfluence(influence);
      if (stage === 'noise') return false;
      const glyphs = stage === 'mask' ? maskGlyphs : stage === 'partial' ? partialGlyphs : resolvedGlyphs;
      const stride = stage === 'resolved' ? 31 : stage === 'partial' ? 23 : 17;
      if (particle.glyphIndex % stride !== 0) return false;

      const glyph = glyphs[particle.glyphIndex % glyphs.length];
      context.font = `${stage === 'resolved' ? 11 : 9}px ui-monospace, SFMono-Regular, Menlo, monospace`;
      context.fillStyle = `rgba(244, 244, 237, ${Math.min(0.92, alpha + influence * 0.35)})`;
      context.fillText(glyph, x, y);
      return true;
    };

    const draw = (now: number) => {
      const delta = Math.min(2, (now - previousFrame) / 16.67);
      previousFrame = now;
      frameCount += 1;

      context.globalCompositeOperation = 'source-over';
      context.fillStyle = 'rgba(3, 3, 3, 0.17)';
      context.fillRect(0, 0, width, height);

      pointer.energy += ((pointer.active ? 1 : 0) - pointer.energy) * 0.055;
      pointer.speed *= 0.9;
      const radius = Math.min(width, height) * (window.innerWidth < 700 ? 0.34 : 0.3);

      if (pointer.energy > 0.01) {
        const halo = context.createRadialGradient(pointer.x, pointer.y, 0, pointer.x, pointer.y, radius * 1.45);
        halo.addColorStop(0, `rgba(247, 247, 239, ${0.15 * pointer.energy})`);
        halo.addColorStop(0.24, `rgba(213, 220, 238, ${0.05 * pointer.energy})`);
        halo.addColorStop(0.62, `rgba(145, 161, 198, ${0.012 * pointer.energy})`);
        halo.addColorStop(1, 'rgba(0, 0, 0, 0)');
        context.fillStyle = halo;
        context.fillRect(pointer.x - radius * 1.5, pointer.y - radius * 1.5, radius * 3, radius * 3);
      }

      context.globalCompositeOperation = 'lighter';
      for (const particle of particles) {
        const dx = pointer.x - particle.x;
        const dy = pointer.y - particle.y;
        const distance = Math.hypot(dx, dy) || 1;
        const local = pointer.energy * Math.max(0, 1 - distance / radius);
        const influence = local * local;
        const driftX = Math.sin(now * 0.00018 + particle.seed) * (0.18 + particle.depth * 0.24);
        const driftY = Math.cos(now * 0.00015 + particle.seed * 1.7) * (0.12 + particle.depth * 0.18);

        if (influence > 0) {
          const horizontalDecode = 0.026 * influence * delta;
          const verticalDecode = 0.008 * influence * delta;
          particle.x += dx * horizontalDecode;
          particle.y += dy * verticalDecode + Math.sin(now * 0.001 + particle.seed) * influence * 0.16;
        } else {
          particle.x += (particle.originX - particle.x) * 0.008 * delta + driftX * delta;
          particle.y += (particle.originY - particle.y) * 0.008 * delta + driftY * delta;
        }

        const alpha = 0.028 + particle.depth * 0.08 + influence * 0.82;
        const x = particle.x;
        const y = particle.y;
        if (!drawGlyph(particle, influence, x, y, alpha)) {
          const size = particle.size * (0.65 + particle.depth + influence * 1.75);
          context.fillStyle = `rgba(229, 231, 224, ${Math.min(0.88, alpha)})`;
          context.fillRect(x, y, size, size);
        }

        if (influence > 0.24 && pointer.speed > 3 && particle.glyphIndex % 7 === 0) {
          context.strokeStyle = `rgba(225, 229, 221, ${influence * Math.min(pointer.speed / 42, 1) * 0.07})`;
          context.lineWidth = 0.45;
          context.beginPath();
          context.moveTo(x, y);
          context.lineTo(
            x - (pointer.x - pointer.previousX) * 0.55,
            y - (pointer.y - pointer.previousY) * 0.55,
          );
          context.stroke();
        }
      }
      context.globalCompositeOperation = 'source-over';

      pointer.previousX += (pointer.x - pointer.previousX) * 0.24;
      pointer.previousY += (pointer.y - pointer.previousY) * 0.24;

      if (frameCount >= 120) {
        const fps = 120000 / Math.max(1, now - frameWindowStarted);
        const nextDensity = densityForFps(fps, density);
        if (nextDensity < density) {
          density = nextDensity;
          rebuildParticles();
        }
        frameCount = 0;
        frameWindowStarted = now;
      }

      frameHandle = requestAnimationFrame(draw);
    };

    const observer = new ResizeObserver(resize);
    observer.observe(field);
    resize();
    frameHandle = requestAnimationFrame(draw);

    motionQuery.addEventListener('change', (event) => {
      if (event.matches) {
        cancelAnimationFrame(frameHandle);
        field.dataset.motion = 'reduced';
      } else {
        field.dataset.motion = 'full';
        previousFrame = performance.now();
        frameHandle = requestAnimationFrame(draw);
      }
    });
  });
</script>

<style>
  .denoise-field {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 72% 50%, rgb(255 255 248 / 0.035), transparent 30%),
      #030303;
  }

  canvas {
    width: 100%;
    height: 100%;
  }

  .field-readout {
    position: absolute;
    right: 0;
    bottom: 1rem;
    left: 0;
    display: flex;
    justify-content: space-between;
    color: #4c4c48;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.55rem;
    letter-spacing: 0.14em;
  }

  @media (max-width: 700px) {
    .field-readout {
      display: none;
    }

  }
</style>

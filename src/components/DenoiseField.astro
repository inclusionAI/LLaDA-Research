<div
  class="denoise-field"
  data-denoise-field
  data-field-theme="sage-light"
  data-canvas-surface="ivory-trail"
  data-pointer-spotlight="none"
  data-visual-system="coherence-field"
  data-decode-window-ms="650"
  data-edit-mode="simultaneous"
  data-materials="micro stroke mask semantic"
  data-density-basis="165"
  data-animation-loops="1"
  data-edit-count="2"
  data-pointer-glyphs="mask partial resolved"
  data-skeleton-max-opacity="0.28"
  data-skeleton-surface="canvas"
  data-skeleton-compositing="trail-compensated"
  data-skeleton-layout-transition="interpolated-crossfade"
  data-skeleton-mobile-occlusion="shared"
  data-coherence-state="noise"
  data-motion="full"
  data-interacting="false"
  aria-hidden="true"
>
  <canvas></canvas>
  <div class="field-readout">
    <span>MASK / TOKEN</span>
    <span>PARALLEL DIFFUSION / EDITING</span>
  </div>
</div>

<script>
  import {
    clampSemanticOffset,
    coherencePhaseAt,
    coherenceWeight,
    densityForFps,
    materialForIndex,
    normalizedPointerSpeed,
    resolveParticlePosition,
    semanticFontSize,
    semanticOffsetDecayFactor,
    semanticSkeletonLayers,
    semanticSkeletonOpacity,
    sourceAlphaForCompositedOpacity,
    strokeTangentAt,
    tokenStageForInfluence,
  } from '../lib/particle-field';
  import type { CoherencePhase, ParticleMaterial } from '../lib/particle-field';

  type Point = {
    x: number;
    y: number;
    editGroup: number;
    layoutGroup: number;
    layoutIndex: number;
    layoutSize: number;
    tangentX: number;
    tangentY: number;
  };
  type Particle = {
    x: number;
    y: number;
    originX: number;
    originY: number;
    depth: number;
    seed: number;
    size: number;
    index: number;
    material: ParticleMaterial;
    spectral: boolean;
    target?: Point;
    replacement?: Point;
    semanticOffsetX: number;
    semanticOffsetY: number;
  };
  type SemanticTokenLayout = {
    text: string;
    x: number;
    baselineY: number;
    width: number;
    row: number;
    tokenIndex: number;
    editGroup: number;
  };
  type SemanticLayout = {
    font: string;
    fontSize: number;
    originX: number;
    originY: number;
    sampleSize: number;
    tokens: SemanticTokenLayout[];
  };

  const maskGlyphs = ['[··]', '[  ]', '▧', '░'];
  const partialGlyphs = ['DIFF', 'LANG', 'TOK', '∇x'];
  const resolvedGlyphs = ['LLaDA', 'language', 'parallel', 'editing'];
  const generatedLines = [
    ['LANGUAGE', 'FORMS'],
    ['TOKENS', 'RESOLVE'],
  ];
  const editedLines = [
    ['LANGUAGE', 'ADAPTS'],
    ['TOKENS', 'EDIT'],
  ];
  const editGroups = [
    [-1, 0],
    [-1, 1],
  ];

  document.querySelectorAll<HTMLElement>('[data-denoise-field]').forEach((field) => {
    const canvas = field.querySelector('canvas');
    const context = canvas?.getContext('2d', { alpha: true });
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!canvas || !context) return;

    let width = 1;
    let height = 1;
    let ratio = 1;
    let density = window.matchMedia('(max-width: 700px)').matches ? 0.58 : 1;
    let particles: Particle[] = [];
    let frameHandle = 0;
    let frameCount = 0;
    let frameWindowStarted = performance.now();
    let previousFrame = frameWindowStarted;
    let cycleStarted = frameWindowStarted;
    let hiddenAt = 0;
    let interactionTimer = 0;
    let semanticLineCount = 2;
    let semanticLayouts: { initial: SemanticLayout; replacement: SemanticLayout } | undefined;
    let maximumSemanticDisplacement = 0;
    let consumedPointerRevision = 0;
    const pointer = {
      x: 0,
      y: 0,
      previousX: 0,
      previousY: 0,
      velocityX: 0,
      velocityY: 0,
      speed: 0,
      active: false,
      positioned: false,
      eventTimestamp: 0,
      energy: 0,
      revision: 0,
    };
    const canvasTrailRetention = 0.8;
    const ambientBaseAlpha = 0.06;

    const updateDataset = (name: string, value: string) => {
      if (field.dataset[name] !== value) field.dataset[name] = value;
    };

    const geometry = () => {
      const mobile = width < 700;
      const tablet = width >= 700 && width < 960;
      const side = mobile ? Math.min(width * 0.7, 280) : tablet ? Math.min(width * 0.34, 340) : Math.min(390, Math.max(280, width * 0.27));
      return {
        centerX: mobile ? width - side / 2 - 4 : width * (tablet ? 0.78 : 0.78),
        centerY: height * (mobile ? 0.8 : tablet ? 0.57 : 0.5),
        side,
        feather: Math.max(32, Math.min(48, side * 0.12)),
      };
    };

    const layoutSemanticTokens = (
      drawingContext: CanvasRenderingContext2D,
      lines: string[][],
    ) => {
      const { centerX, centerY, side } = geometry();
      const mobile = width < 700;
      const sampleSize = Math.max(1, Math.round(side));
      const fontSize = semanticFontSize(side, mobile);
      const gap = fontSize * 0.82;
      const lineGap = mobile ? fontSize * 1.45 : side * 0.18;
      const visibleLines = lines.slice(0, semanticLineCount);
      const tokens: SemanticTokenLayout[] = [];
      const font = `500 ${fontSize}px ui-monospace, SFMono-Regular, Menlo, monospace`;
      let semanticCenterY = centerY;

      if (mobile) {
        const fieldBounds = field.getBoundingClientRect();
        const links = field.closest('.research-hero')?.querySelector<HTMLElement>('.hero-links');
        const linksBounds = links?.getBoundingClientRect();
        const linksBottom = linksBounds ? linksBounds.bottom - fieldBounds.top : height * 0.76;
        const inkHalfHeight = lineGap * (visibleLines.length - 1) / 2 + fontSize * 0.55;
        const minimumCenter = linksBottom + 4 + inkHalfHeight;
        const maximumCenter = height - 4 - inkHalfHeight;
        semanticCenterY = Math.max(
          minimumCenter,
          Math.min(maximumCenter, (linksBottom + height) / 2),
        );
      }

      drawingContext.font = font;
      drawingContext.textBaseline = 'middle';
      visibleLines.forEach((line, row) => {
        const widths = line.map((token) => drawingContext.measureText(token).width);
        const lineWidth = widths.reduce((sum, tokenWidth) => sum + tokenWidth, 0) + gap * (line.length - 1);
        let cursorX = (sampleSize - lineWidth) / 2;
        const baselineY = sampleSize / 2 + (row - (visibleLines.length - 1) / 2) * lineGap;

        line.forEach((text, tokenIndex) => {
          tokens.push({
            text,
            x: cursorX,
            baselineY,
            width: widths[tokenIndex],
            row,
            tokenIndex,
            editGroup: editGroups[row]?.[tokenIndex] ?? -1,
          });
          cursorX += widths[tokenIndex] + gap;
        });
      });

      return {
        font,
        fontSize,
        originX: centerX - side / 2,
        originY: semanticCenterY - side / 2,
        sampleSize,
        tokens,
      };
    };

    const sampleLayout = (layout: SemanticLayout) => {
      const samplingCanvas = document.createElement('canvas');
      const samplingContext = samplingCanvas.getContext('2d', { willReadFrequently: true });
      if (!samplingContext) return [] as Point[];
      const { font, fontSize, originX, originY, sampleSize, tokens } = layout;
      samplingCanvas.width = sampleSize;
      samplingCanvas.height = sampleSize;
      const points: Point[] = [];

      samplingContext.font = font;
      samplingContext.textBaseline = 'middle';
      samplingContext.fillStyle = '#fff';
      tokens.forEach((token) => {
        const tokenPoints: Omit<Point, 'layoutIndex' | 'layoutSize'>[] = [];
        samplingContext.clearRect(0, 0, sampleSize, sampleSize);
        samplingContext.fillText(token.text, token.x, token.baselineY);
        const left = Math.max(0, Math.floor(token.x - 1));
        const top = Math.max(0, Math.floor(token.baselineY - fontSize));
        const sampleWidth = Math.min(sampleSize - left, Math.ceil(token.width + 3));
        const sampleHeight = Math.min(sampleSize - top, Math.ceil(fontSize * 1.35));
        const pixels = samplingContext.getImageData(left, top, sampleWidth, sampleHeight).data;
        const alpha = new Uint8ClampedArray(sampleWidth * sampleHeight);

        for (let index = 0; index < alpha.length; index += 1) {
          alpha[index] = pixels[index * 4 + 3];
        }

        for (let y = 0; y < sampleHeight; y += 1) {
          for (let x = 0; x < sampleWidth; x += 1) {
            if (alpha[y * sampleWidth + x] > 80) {
              const tangent = strokeTangentAt(alpha, sampleWidth, sampleHeight, x, y);
              tokenPoints.push({
                x: originX + left + x,
                y: originY + top + y,
                editGroup: token.editGroup,
                layoutGroup: token.row * 2 + token.tokenIndex,
                tangentX: tangent.x,
                tangentY: tangent.y,
              });
            }
          }
        }
        tokenPoints.forEach((point, layoutIndex) => points.push({
          ...point,
          layoutIndex,
          layoutSize: tokenPoints.length,
        }));
      });
      return points;
    };

    const cacheSemanticLayouts = () => {
      semanticLayouts = {
        initial: layoutSemanticTokens(context, generatedLines),
        replacement: layoutSemanticTokens(context, editedLines),
      };
    };

    const makeParticle = (index: number): Particle => {
      const band = index % 7;
      const centerY = height * (0.18 + band * 0.105);
      const fieldStart = width < 700 ? 0.5 : 0.38;
      const x = width * (fieldStart + Math.random() * (1.02 - fieldStart));
      const y = centerY + (Math.random() + Math.random() - 1) * height * 0.105;
      return {
        x,
        y,
        originX: x,
        originY: y,
        depth: (index % 3) / 2,
        seed: Math.random() * 1000,
        size: 0.35 + Math.random() * 0.8,
        index,
        material: materialForIndex(index),
        spectral: index % 23 === 0,
        semanticOffsetX: 0,
        semanticOffsetY: 0,
      };
    };

    const assignSemanticTargets = () => {
      if (!semanticLayouts) return;
      const initialTargets = sampleLayout(semanticLayouts.initial);
      const replacementTargets = sampleLayout(semanticLayouts.replacement);
      const semanticTargets = [...initialTargets, ...replacementTargets];
      if (semanticTargets.length > 0) {
        field.dataset.semanticTop = Math.min(...semanticTargets.map((point) => point.y)).toFixed(1);
        field.dataset.semanticBottom = Math.max(...semanticTargets.map((point) => point.y)).toFixed(1);
        field.dataset.semanticLeft = Math.min(...semanticTargets.map((point) => point.x)).toFixed(1);
        field.dataset.semanticRight = Math.max(...semanticTargets.map((point) => point.x)).toFixed(1);
      }
      const replacementsByLayoutGroup = [0, 1, 2, 3].map((group) => (
        replacementTargets.filter((point) => point.layoutGroup === group)
      ));
      const { centerX, centerY } = geometry();
      const candidates = particles.filter((particle) => particle.index % 2 === 0).sort((a, b) => (
        Math.hypot(a.originX - centerX, a.originY - centerY) - Math.hypot(b.originX - centerX, b.originY - centerY)
      ));
      const targetCount = Math.min(candidates.length, width < 700 ? 520 : 900);
      let unchangedLayoutShifts = 0;

      for (let index = 0; index < targetCount; index += 1) {
        const particle = candidates[index];
        const target = initialTargets[Math.floor(index * initialTargets.length / Math.max(1, targetCount))];
        if (!target) continue;
        particle.target = target;
        const replacements = replacementsByLayoutGroup[target.layoutGroup];
        const replacementIndex = Math.floor(
          target.layoutIndex * replacements.length / Math.max(1, target.layoutSize),
        );
        particle.replacement = replacements[Math.min(replacements.length - 1, replacementIndex)] || target;
        if (target.editGroup < 0 && Math.hypot(
          particle.replacement.x - target.x,
          particle.replacement.y - target.y,
        ) > 0.5) {
          unchangedLayoutShifts += 1;
        }
      }
      field.dataset.targetParticles = String(targetCount);
      field.dataset.unchangedLayoutShifts = String(unchangedLayoutShifts);
    };

    const rebuildParticles = () => {
      const particleCount = Math.round((width * height) / 165 * density);
      particles = Array.from({ length: particleCount }, (_, index) => makeParticle(index));
      maximumSemanticDisplacement = 0;
      field.dataset.semanticTangentAlignment = '0.000';
      assignSemanticTargets();
    };

    const resize = () => {
      const bounds = field.getBoundingClientRect();
      width = Math.max(1, bounds.width);
      height = Math.max(1, bounds.height);
      ratio = Math.min(window.devicePixelRatio || 1, 2);
      semanticLineCount = 2;
      field.dataset.semanticLines = String(semanticLineCount);
      const coherenceGeometry = geometry();
      field.dataset.coherenceSide = String(Math.round(coherenceGeometry.side));
      field.dataset.coherenceX = String(Math.round(coherenceGeometry.centerX));
      field.dataset.semanticCopy = 'LANGUAGE FORMS / TOKENS RESOLVE';
      field.dataset.semanticFontSize = String(semanticFontSize(coherenceGeometry.side, width < 700));
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      cacheSemanticLayouts();
      rebuildParticles();
    };

    const markInteraction = () => {
      field.dataset.interacting = 'true';
      window.clearTimeout(interactionTimer);
      interactionTimer = window.setTimeout(() => {
        field.dataset.interacting = 'false';
      }, 1100);
    };

    const updatePointer = (event: PointerEvent) => {
      const coalescedEvents = event.getCoalescedEvents?.() || [];
      const pointerEvent = coalescedEvents[coalescedEvents.length - 1] || event;
      const bounds = field.getBoundingClientRect();
      const nextX = pointerEvent.clientX - bounds.left;
      const nextY = pointerEvent.clientY - bounds.top;
      pointer.velocityX = pointer.positioned ? nextX - pointer.x : 0;
      pointer.velocityY = pointer.positioned ? nextY - pointer.y : 0;
      const elapsedMs = pointerEvent.timeStamp - pointer.eventTimestamp;
      pointer.speed = pointer.positioned
        ? Math.min(42, normalizedPointerSpeed(Math.hypot(pointer.velocityX, pointer.velocityY), elapsedMs))
        : 0;
      pointer.previousX = pointer.positioned ? pointer.x : nextX;
      pointer.previousY = pointer.positioned ? pointer.y : nextY;
      pointer.x = nextX;
      pointer.y = nextY;
      pointer.active = true;
      pointer.positioned = true;
      pointer.eventTimestamp = pointerEvent.timeStamp;
      pointer.energy = Math.min(1, pointer.energy + 0.22);
      pointer.revision += 1;
      markInteraction();
    };

    field.addEventListener('pointerenter', updatePointer);
    field.addEventListener('pointermove', updatePointer);
    field.addEventListener('pointerleave', () => {
      pointer.active = false;
      markInteraction();
    });

    const drawAmbientMaterial = (particle: Particle, x: number, y: number, alpha: number, driftX: number, driftY: number) => {
      const channels = particle.spectral ? '82, 122, 104' : particle.depth > 0.7 ? '104, 117, 110' : '126, 145, 134';
      const size = particle.size * (0.72 + particle.depth);
      if (particle.material === 'stroke') {
        const angle = Math.atan2(driftY, driftX);
        const length = 2.5 + particle.depth * 5;
        context.strokeStyle = `rgba(${channels}, ${alpha * 0.68})`;
        context.lineWidth = 0.35 + particle.depth * 0.2;
        context.beginPath();
        context.moveTo(x, y);
        context.lineTo(x + Math.cos(angle) * length, y + Math.sin(angle) * length);
        context.stroke();
        return;
      }
      if (particle.material === 'mask') {
        context.font = `${5.5 + particle.depth * 1.5}px ui-monospace, SFMono-Regular, Menlo, monospace`;
        context.fillStyle = `rgba(${channels}, ${alpha * 0.26})`;
        context.fillText(maskGlyphs[particle.index % maskGlyphs.length], x, y);
        return;
      }
      context.fillStyle = `rgba(${channels}, ${alpha})`;
      context.fillRect(x, y, size, size * 0.72);
    };

    const drawPointerGlyph = (particle: Particle, influence: number) => {
      if (influence < 0.18 || particle.index % 29 !== 0) return false;
      const stage = tokenStageForInfluence(influence);
      if (stage === 'noise') return false;
      const glyphs = stage === 'mask' ? maskGlyphs : stage === 'partial' ? partialGlyphs : resolvedGlyphs;
      context.font = `${stage === 'resolved' ? 9 : 7}px ui-monospace, SFMono-Regular, Menlo, monospace`;
      context.fillStyle = `rgba(82, 122, 104, ${Math.min(0.42, 0.1 + influence * 0.32)})`;
      context.fillText(glyphs[particle.index % glyphs.length], particle.x, particle.y);
      return true;
    };

    const drawPhaseEdges = (phase: CoherencePhase) => {
      if ((phase.name !== 'align' && phase.name !== 'fragment') || phase.coherence < 0.08) return;
      const { centerX, centerY, side } = geometry();
      const alpha = Math.min(0.16, phase.coherence * 0.16);
      context.strokeStyle = `rgba(82, 122, 104, ${alpha})`;
      context.lineWidth = 0.55;
      context.beginPath();
      context.moveTo(centerX - side / 2, centerY - side / 2 + 10);
      context.lineTo(centerX - side / 2, centerY - side / 2 + 28);
      context.moveTo(centerX + side / 2 - 22, centerY + side / 2);
      context.lineTo(centerX + side / 2 - 7, centerY + side / 2);
      context.stroke();
    };

    const semanticPointerProximityAt = (x: number, y: number, radius: number) => {
      if (!pointer.active) return 0;
      return Math.max(0, 1 - Math.hypot(pointer.x - x, pointer.y - y) / Math.max(1, radius));
    };

    const updateSemanticPointerMotion = (elapsedMs: number, phase: CoherencePhase, side: number) => {
      const proximityRadius = Math.max(36, side * 0.22);
      const hasFreshPointerEvent = pointer.revision !== consumedPointerRevision;
      const movementLength = Math.hypot(pointer.velocityX, pointer.velocityY) || 1;
      const movementX = pointer.velocityX / movementLength;
      const movementY = pointer.velocityY / movementLength;
      const decay = semanticOffsetDecayFactor(elapsedMs);
      let semanticProximity = 0;
      let semanticDisplacement = 0;
      let tangentAlignmentTotal = 0;
      let tangentAlignmentSamples = 0;

      for (const particle of particles) {
        if (!particle.target) continue;
        particle.semanticOffsetX *= decay;
        particle.semanticOffsetY *= decay;

        const replacement = particle.replacement || particle.target;
        const targetX = particle.target.x + (replacement.x - particle.target.x) * phase.replacement;
        const targetY = particle.target.y + (replacement.y - particle.target.y) * phase.replacement;
        const targetDx = targetX - pointer.x;
        const targetDy = targetY - pointer.y;
        const targetDistance = Math.hypot(targetDx, targetDy);
        const proximity = pointer.active
          ? Math.max(0, 1 - targetDistance / proximityRadius)
          : 0;
        semanticProximity = Math.max(semanticProximity, proximity);

        if (hasFreshPointerEvent && pointer.speed >= 4 && proximity > 0) {
          let replacementTangentX = replacement.tangentX;
          let replacementTangentY = replacement.tangentY;
          if (
            particle.target.tangentX * replacementTangentX
              + particle.target.tangentY * replacementTangentY < 0
          ) {
            replacementTangentX *= -1;
            replacementTangentY *= -1;
          }
          let tangentX = particle.target.tangentX
            + (replacementTangentX - particle.target.tangentX) * phase.replacement;
          let tangentY = particle.target.tangentY
            + (replacementTangentY - particle.target.tangentY) * phase.replacement;
          const tangentLength = Math.hypot(tangentX, tangentY) || 1;
          tangentX /= tangentLength;
          tangentY /= tangentLength;
          if (tangentX * movementX + tangentY * movementY < 0) {
            tangentX *= -1;
            tangentY *= -1;
          }
          const impulse = 7.2 * Math.min(1, pointer.speed / 42) * proximity * proximity;
          const offset = clampSemanticOffset({
            x: particle.semanticOffsetX + tangentX * impulse,
            y: particle.semanticOffsetY + tangentY * impulse,
          });
          particle.semanticOffsetX = offset.x;
          particle.semanticOffsetY = offset.y;
          const offsetLength = Math.hypot(offset.x, offset.y);
          if (offsetLength > 0) {
            tangentAlignmentTotal += Math.abs(
              (offset.x * tangentX + offset.y * tangentY) / offsetLength,
            );
            tangentAlignmentSamples += 1;
          }
        }

        semanticDisplacement = Math.max(
          semanticDisplacement,
          Math.hypot(particle.semanticOffsetX, particle.semanticOffsetY),
        );
      }

      if (hasFreshPointerEvent) consumedPointerRevision = pointer.revision;
      maximumSemanticDisplacement = Math.max(maximumSemanticDisplacement, semanticDisplacement);
      updateDataset('semanticProximity', semanticProximity.toFixed(3));
      updateDataset('semanticProximityState', semanticProximity > 0 ? 'near' : 'far');
      updateDataset('semanticDisplacement', semanticDisplacement.toFixed(2));
      updateDataset('semanticMaxDisplacement', maximumSemanticDisplacement.toFixed(2));
      updateDataset('semanticRest', !pointer.active && semanticDisplacement <= 0.9 ? 'true' : 'false');
      updateDataset('semanticImpulseRevision', String(consumedPointerRevision));
      if (tangentAlignmentSamples > 0) {
        updateDataset(
          'semanticTangentAlignment',
          (tangentAlignmentTotal / tangentAlignmentSamples).toFixed(3),
        );
      }
    };

    const semanticFalloff = (
      x: number,
      y: number,
      centerX: number,
      centerY: number,
      side: number,
      feather: number,
      skeletonStrength: number,
    ) => {
      const radius = side * 0.54;
      const radialDistance = Math.hypot(x - centerX, y - centerY) / radius;
      const radialWeight = Math.max(0, 1 - radialDistance);
      return coherenceWeight(x, y, centerX, centerY, side, feather)
        * radialWeight * radialWeight
        * skeletonStrength;
    };

    const drawSkeletonGlyph = (
      text: string,
      x: number,
      y: number,
      compositedOpacity: number,
      trailRetention: number,
    ) => {
      if (compositedOpacity <= 0.001) return 0;
      const drawAtOpacity = (opacity: number) => {
        const sourceOpacity = sourceAlphaForCompositedOpacity(opacity, trailRetention);
        context.fillStyle = `rgba(82, 122, 104, ${sourceOpacity})`;
        context.fillText(text, x, y);
        return sourceOpacity;
      };

      if (width >= 700) return drawAtOpacity(compositedOpacity);

      const occlusionWidth = width * 0.84;
      const occlusionTop = height * 0.43;
      const occlusionHeight = height * 0.33;
      context.save();
      context.beginPath();
      context.rect(0, 0, width, height);
      context.rect(0, occlusionTop, occlusionWidth, occlusionHeight);
      context.clip('evenodd');
      const sourceOpacity = drawAtOpacity(compositedOpacity);
      context.restore();

      context.save();
      context.beginPath();
      context.rect(0, occlusionTop, occlusionWidth, occlusionHeight);
      context.clip();
      drawAtOpacity(compositedOpacity * 0.25);
      context.restore();
      return sourceOpacity;
    };

    const drawSemanticSkeleton = (phase: CoherencePhase, trailRetention: number) => {
      if (!semanticLayouts) return;
      const { initial, replacement } = semanticLayouts;
      let compositedOpacity = 0;
      let sourceOpacity = 0;

      context.font = initial.font;
      context.textBaseline = 'middle';
      initial.tokens.forEach((initialToken, index) => {
        const replacementToken = replacement.tokens[index] || initialToken;
        const changed = initialToken.text !== replacementToken.text;
        const position = resolveParticlePosition(
          {
            x: initial.originX + initialToken.x,
            y: initial.originY + initialToken.baselineY,
          },
          {
            x: replacement.originX + replacementToken.x,
            y: replacement.originY + replacementToken.baselineY,
          },
          phase.replacement,
        );
        const tokenWidth = initialToken.width + (replacementToken.width - initialToken.width) * phase.replacement;
        const pointerProximity = semanticPointerProximityAt(
          position.x + tokenWidth / 2,
          position.y,
          geometry().side * 0.28,
        );
        const tokenOpacity = semanticSkeletonOpacity(
          phase.decode,
          initialToken.editGroup >= 0 ? phase.edit : 0,
          phase.disperse,
          pointerProximity,
        );
        const layers = semanticSkeletonLayers(tokenOpacity, phase.replacement, changed);

        compositedOpacity = Math.max(compositedOpacity, tokenOpacity);
        sourceOpacity = Math.max(
          sourceOpacity,
          drawSkeletonGlyph(initialToken.text, position.x, position.y, layers.initial, trailRetention),
        );
        if (layers.replacement > 0.001) {
          sourceOpacity = Math.max(
            sourceOpacity,
            drawSkeletonGlyph(replacementToken.text, position.x, position.y, layers.replacement, trailRetention),
          );
        }
      });

      const skeletonState = compositedOpacity <= 0.001
        ? 'inactive'
        : phase.edit > 0.04
          ? 'fragmenting'
          : 'active';
      const skeletonCopy = phase.replacement <= 0
        ? 'initial'
        : phase.replacement >= 1
          ? 'replacement'
          : 'transition';
      updateDataset('skeletonOpacity', compositedOpacity.toFixed(3));
      updateDataset('skeletonSourceOpacity', sourceOpacity.toFixed(3));
      updateDataset('skeletonState', skeletonState);
      updateDataset('skeletonCopy', skeletonCopy);
    };

    const updateState = (phase: CoherencePhase) => {
      const coherenceState = phase.name === 'hold' || phase.name === 'resolved'
        ? 'resolved'
        : phase.name === 'fragment' || phase.name === 'reform'
          ? 'editing'
          : phase.name;
      updateDataset('coherenceState', coherenceState);
    };

    const renderFrame = (now: number, fixedPhase?: CoherencePhase) => {
      const elapsedMs = Math.max(0, now - previousFrame);
      const delta = Math.min(2, (now - previousFrame) / 16.67);
      previousFrame = now;
      frameCount += 1;
      const phase = fixedPhase || coherencePhaseAt(now - cycleStarted);
      if (!fixedPhase) updateState(phase);
      const { centerX, centerY, side, feather } = geometry();

      context.globalCompositeOperation = 'source-over';
      context.fillStyle = fixedPhase ? '#f7f8f3' : `rgba(247, 248, 243, ${1 - canvasTrailRetention})`;
      context.fillRect(0, 0, width, height);

      pointer.energy += ((pointer.active ? 1 : 0) - pointer.energy) * 0.055;
      pointer.speed *= 0.9;
      const pointerRadius = Math.min(width, height) * (width < 700 ? 0.34 : 0.3);
      updateSemanticPointerMotion(elapsedMs, phase, side);
      const ambientSkeletonStrength = semanticSkeletonOpacity(phase.decode, 0, phase.disperse, 0) / 0.24;
      let targetError = 0;
      let targetSamples = 0;
      for (const particle of particles) {
        const driftX = Math.sin(now * 0.00018 + particle.seed) * (0.16 + particle.depth * 0.22);
        const driftY = Math.cos(now * 0.00015 + particle.seed * 1.7) * (0.11 + particle.depth * 0.16);
        const ambientX = particle.originX + driftX * 24;
        const ambientY = particle.originY + driftY * 22;
        let desiredX = ambientX;
        let desiredY = ambientY;
        let semanticStrength = 0;

        if (particle.target) {
          const localCoherence = coherenceWeight(particle.originX, particle.originY, centerX, centerY, side, feather);
          semanticStrength = phase.coherence * (
            phase.decode + (1 - phase.decode) * (0.48 + localCoherence * 0.52)
          );
          const replacement = particle.replacement || particle.target;
          let semanticX = particle.target.x + (replacement.x - particle.target.x) * phase.replacement;
          let semanticY = particle.target.y + (replacement.y - particle.target.y) * phase.replacement;
          if (particle.target.editGroup >= 0 && phase.edit > 0) {
            semanticX += Math.sin(particle.seed * 1.9) * phase.edit * (8 + particle.depth * 8);
            semanticY += Math.cos(particle.seed * 2.3) * phase.edit * (5 + particle.depth * 5);
          }
          semanticX += particle.semanticOffsetX;
          semanticY += particle.semanticOffsetY;
          const bandX = Math.max(centerX - side * 0.46, Math.min(centerX + side * 0.46, particle.originX));
          const orderedX = bandX + (semanticX - bandX) * phase.decode;
          const orderedY = semanticY;
          const resolved = resolveParticlePosition(
            { x: desiredX, y: desiredY },
            { x: orderedX, y: orderedY },
            semanticStrength,
          );
          desiredX = resolved.x;
          desiredY = resolved.y;
        }

        const pointerDx = pointer.x - particle.x;
        const pointerDy = pointer.y - particle.y;
        const pointerDistance = Math.hypot(pointerDx, pointerDy) || 1;
        const pointerInfluence = pointer.energy * Math.max(0, 1 - pointerDistance / pointerRadius);
        if (pointerInfluence > 0 && (!particle.target || semanticStrength <= 0)) {
          desiredX += pointerDx * pointerInfluence * 0.075;
          desiredY += pointerDy * pointerInfluence * 0.028;
        }

        if (semanticStrength > 0) {
          particle.x = desiredX;
          particle.y = desiredY;
        } else {
          particle.x += (desiredX - particle.x) * 0.055 * delta;
          particle.y += (desiredY - particle.y) * 0.055 * delta;
        }
        const semanticActive = Boolean(particle.target && phase.decode > 0.04 && semanticStrength > 0.05);
        const editing = Boolean(particle.target && particle.target.editGroup >= 0 && phase.edit > 0.04);
        const mobileCopyOcclusion = width < 700
          && particle.x < width * 0.84
          && particle.y > height * 0.43
          && particle.y < height * 0.76
          ? 0.25
          : 1;
        const ambientAttenuation = semanticActive
          ? 1
          : 1 - semanticFalloff(
            particle.x,
            particle.y,
            centerX,
            centerY,
            side,
            feather,
            ambientSkeletonStrength,
          ) * 0.42;
        const alpha = Math.min(
          0.9,
          (ambientBaseAlpha + particle.depth * 0.12 + pointerInfluence * 0.34 + semanticStrength * 0.48)
            * mobileCopyOcclusion * ambientAttenuation,
        );

        if (semanticActive) {
          const mineral = editing && particle.index % 4 === 0;
          context.fillStyle = mineral
            ? `rgba(63, 104, 87, ${Math.min(0.46, alpha)})`
            : `rgba(82, 122, 104, ${Math.min(0.52, alpha)})`;
          const semanticSize = 0.68 + particle.depth * 0.76;
          context.fillRect(particle.x, particle.y, semanticSize, semanticSize * 0.78);
        } else if (!drawPointerGlyph(particle, pointerInfluence) && (particle.material !== 'semantic' || phase.coherence > 0.08)) {
          drawAmbientMaterial(particle, particle.x, particle.y, alpha, driftX, driftY);
        }

        if (field.dataset.coherenceState === 'resolved' && particle.target) {
          const target = phase.replacement >= 1 ? (particle.replacement || particle.target) : particle.target;
          targetError += Math.hypot(particle.x - target.x, particle.y - target.y);
          targetSamples += 1;
        }

        if (pointerInfluence > 0.24 && pointer.speed > 3 && particle.index % 7 === 0) {
          context.strokeStyle = `rgba(82, 122, 104, ${pointerInfluence * Math.min(pointer.speed / 42, 1) * 0.07})`;
          context.lineWidth = 0.45;
          context.beginPath();
          context.moveTo(particle.x, particle.y);
          context.lineTo(
            particle.x - (pointer.x - pointer.previousX) * 0.55,
            particle.y - (pointer.y - pointer.previousY) * 0.55,
          );
          context.stroke();
        }
      }

      drawSemanticSkeleton(phase, fixedPhase ? 0 : canvasTrailRetention);
      if (targetSamples > 0) {
        updateDataset('targetError', (targetError / targetSamples).toFixed(2));
      }

      drawPhaseEdges(phase);
      pointer.previousX += (pointer.x - pointer.previousX) * 0.24;
      pointer.previousY += (pointer.y - pointer.previousY) * 0.24;

      if (!fixedPhase && frameCount >= 120) {
        const fps = 120000 / Math.max(1, now - frameWindowStarted);
        const nextDensity = densityForFps(fps, density);
        if (nextDensity < density) {
          density = nextDensity;
          rebuildParticles();
        }
        frameCount = 0;
        frameWindowStarted = now;
      }
    };

    const draw = (now: number) => {
      frameHandle = 0;
      renderFrame(now);
      frameHandle = requestAnimationFrame(draw);
    };

    const stopAnimation = () => {
      if (frameHandle) cancelAnimationFrame(frameHandle);
      frameHandle = 0;
    };

    const startAnimation = () => {
      if (frameHandle || document.hidden || motionQuery.matches) return;
      frameHandle = requestAnimationFrame(draw);
    };

    const drawReducedSnapshot = () => {
      field.dataset.motion = 'reduced';
      field.dataset.coherenceState = 'partial';
      field.dataset.reducedTargets = field.dataset.targetParticles || '0';
      renderFrame(performance.now(), {
        name: 'decode',
        coherence: 0.82,
        decode: 0.68,
        edit: 0,
        replacement: 0,
        disperse: 0,
      });
    };

    const observer = new ResizeObserver(() => {
      resize();
      if (motionQuery.matches) drawReducedSnapshot();
    });
    observer.observe(field);
    resize();
    updateDataset('cycleEpoch', String(Math.round(cycleStarted)));
    if (motionQuery.matches) {
      drawReducedSnapshot();
    } else {
      startAnimation();
    }

    motionQuery.addEventListener('change', (event) => {
      stopAnimation();
      if (event.matches) {
        drawReducedSnapshot();
      } else {
        field.dataset.motion = 'full';
        previousFrame = performance.now();
        cycleStarted = previousFrame;
        updateDataset('cycleEpoch', String(Math.round(cycleStarted)));
        frameWindowStarted = previousFrame;
        startAnimation();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        hiddenAt = performance.now();
        stopAnimation();
      } else if (!motionQuery.matches) {
        const resumedAt = performance.now();
        cycleStarted += resumedAt - hiddenAt;
        previousFrame = resumedAt;
        frameWindowStarted = resumedAt;
        frameCount = 0;
        startAnimation();
      }
    });
  });
</script>

<style>
  .denoise-field {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    background: transparent;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
  }

  .field-readout {
    position: absolute;
    right: 0;
    bottom: 1rem;
    left: 0;
    display: flex;
    justify-content: space-between;
    color: rgb(104 117 110 / 0.72);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.55rem;
    letter-spacing: 0.14em;
  }

  @media (max-width: 700px) {
    .field-readout {
      display: none;
    }

  }
</style>

<div
  class="denoise-field"
  data-denoise-field
  data-visual-system="coherence-field"
  data-decode-window-ms="650"
  data-edit-mode="simultaneous"
  data-materials="micro stroke mask semantic"
  data-density-basis="165"
  data-animation-loops="1"
  data-edit-count="2"
  data-pointer-glyphs="mask partial resolved"
  data-coherence-state="noise"
  data-motion="full"
  data-interacting="false"
  aria-hidden="true"
>
  <canvas></canvas>
  <div class="field-readout">
    <span>MASK / TOKEN</span>
    <span>PARALLEL DIFFUSION / EDITING</span>
  </div>
</div>

<script>
  import {
    coherencePhaseAt,
    coherenceWeight,
    densityForFps,
    materialForIndex,
    resolveParticlePosition,
    semanticFontSize,
    tokenStageForInfluence,
  } from '../lib/particle-field';
  import type { CoherencePhase, ParticleMaterial } from '../lib/particle-field';

  type Point = {
    x: number;
    y: number;
    editGroup: number;
    layoutGroup: number;
    layoutIndex: number;
    layoutSize: number;
  };
  type Particle = {
    x: number;
    y: number;
    originX: number;
    originY: number;
    depth: number;
    seed: number;
    size: number;
    index: number;
    material: ParticleMaterial;
    spectral: boolean;
    target?: Point;
    replacement?: Point;
  };

  const maskGlyphs = ['[··]', '[  ]', '▧', '░'];
  const partialGlyphs = ['DIFF', 'LANG', 'TOK', '∇x'];
  const resolvedGlyphs = ['LLaDA', 'language', 'parallel', 'editing'];
  const generatedLines = [
    ['LANGUAGE', 'FORMS'],
    ['TOKENS', 'RESOLVE'],
  ];
  const editedLines = [
    ['LANGUAGE', 'ADAPTS'],
    ['TOKENS', 'EDIT'],
  ];
  const editGroups = [
    [-1, 0],
    [-1, 1],
  ];

  document.querySelectorAll<HTMLElement>('[data-denoise-field]').forEach((field) => {
    const canvas = field.querySelector('canvas');
    const context = canvas?.getContext('2d', { alpha: true });
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!canvas || !context) return;

    let width = 1;
    let height = 1;
    let ratio = 1;
    let density = window.matchMedia('(max-width: 700px)').matches ? 0.58 : 1;
    let particles: Particle[] = [];
    let frameHandle = 0;
    let frameCount = 0;
    let frameWindowStarted = performance.now();
    let previousFrame = frameWindowStarted;
    let cycleStarted = frameWindowStarted;
    let hiddenAt = 0;
    let interactionTimer = 0;
    let semanticLineCount = 2;
    const pointer = { x: 0, y: 0, previousX: 0, previousY: 0, speed: 0, active: false, energy: 0 };

    const geometry = () => {
      const mobile = width < 700;
      const tablet = width >= 700 && width < 960;
      const side = mobile ? Math.min(width * 0.7, 280) : tablet ? Math.min(width * 0.34, 340) : Math.min(390, Math.max(280, width * 0.27));
      return {
        centerX: mobile ? width - side / 2 - 4 : width * (tablet ? 0.78 : 0.78),
        centerY: height * (mobile ? 0.8 : tablet ? 0.57 : 0.5),
        side,
        feather: Math.max(32, Math.min(48, side * 0.12)),
      };
    };

    const sampleLines = (lines: string[][], editGroups: number[][]) => {
      const { centerX, centerY, side } = geometry();
      const samplingCanvas = document.createElement('canvas');
      const samplingContext = samplingCanvas.getContext('2d', { willReadFrequently: true });
      if (!samplingContext) return [] as Point[];
      const sampleSize = Math.max(1, Math.round(side));
      samplingCanvas.width = sampleSize;
      samplingCanvas.height = sampleSize;
      const fontSize = semanticFontSize(side, width < 700);
      const gap = fontSize * 0.82;
      const lineGap = side * (semanticLineCount === 2 ? 0.18 : 0.145);
      const visibleLines = lines.slice(0, semanticLineCount);
      const points: Point[] = [];

      samplingContext.font = `500 ${fontSize}px ui-monospace, SFMono-Regular, Menlo, monospace`;
      samplingContext.textBaseline = 'middle';
      samplingContext.fillStyle = '#fff';

      visibleLines.forEach((tokens, row) => {
        const widths = tokens.map((token) => samplingContext.measureText(token).width);
        const lineWidth = widths.reduce((sum, tokenWidth) => sum + tokenWidth, 0) + gap * (tokens.length - 1);
        let cursorX = (sampleSize - lineWidth) / 2;
        const baselineY = sampleSize / 2 + (row - (visibleLines.length - 1) / 2) * lineGap;

        tokens.forEach((token, tokenIndex) => {
          const tokenPoints: Omit<Point, 'layoutIndex' | 'layoutSize'>[] = [];
          samplingContext.clearRect(0, 0, sampleSize, sampleSize);
          samplingContext.fillText(token, cursorX, baselineY);
          const left = Math.max(0, Math.floor(cursorX - 1));
          const top = Math.max(0, Math.floor(baselineY - fontSize));
          const sampleWidth = Math.min(sampleSize - left, Math.ceil(widths[tokenIndex] + 3));
          const sampleHeight = Math.min(sampleSize - top, Math.ceil(fontSize * 1.35));
          const pixels = samplingContext.getImageData(left, top, sampleWidth, sampleHeight).data;

          for (let y = 0; y < sampleHeight; y += 1) {
            for (let x = 0; x < sampleWidth; x += 1) {
              if (pixels[(y * sampleWidth + x) * 4 + 3] > 80) {
                tokenPoints.push({
                  x: centerX - side / 2 + left + x,
                  y: centerY - side / 2 + top + y,
                  editGroup: editGroups[row]?.[tokenIndex] ?? -1,
                  layoutGroup: row * 2 + tokenIndex,
                });
              }
            }
          }
          tokenPoints.forEach((point, layoutIndex) => points.push({
            ...point,
            layoutIndex,
            layoutSize: tokenPoints.length,
          }));
          cursorX += widths[tokenIndex] + gap;
        });
      });
      return points;
    };

    const makeParticle = (index: number): Particle => {
      const band = index % 7;
      const centerY = height * (0.18 + band * 0.105);
      const fieldStart = width < 700 ? 0.5 : 0.38;
      const x = width * (fieldStart + Math.random() * (1.02 - fieldStart));
      const y = centerY + (Math.random() + Math.random() - 1) * height * 0.105;
      return {
        x,
        y,
        originX: x,
        originY: y,
        depth: (index % 3) / 2,
        seed: Math.random() * 1000,
        size: 0.35 + Math.random() * 0.8,
        index,
        material: materialForIndex(index),
        spectral: index % 23 === 0,
      };
    };

    const assignSemanticTargets = () => {
      const initialTargets = sampleLines(generatedLines, editGroups);
      const replacementTargets = sampleLines(editedLines, editGroups);
      const replacementsByLayoutGroup = [0, 1, 2, 3].map((group) => (
        replacementTargets.filter((point) => point.layoutGroup === group)
      ));
      const { centerX, centerY } = geometry();
      const candidates = particles.filter((particle) => particle.index % 2 === 0).sort((a, b) => (
        Math.hypot(a.originX - centerX, a.originY - centerY) - Math.hypot(b.originX - centerX, b.originY - centerY)
      ));
      const targetCount = Math.min(candidates.length, width < 700 ? 520 : 900);
      let unchangedLayoutShifts = 0;

      for (let index = 0; index < targetCount; index += 1) {
        const particle = candidates[index];
        const target = initialTargets[Math.floor(index * initialTargets.length / Math.max(1, targetCount))];
        if (!target) continue;
        particle.target = target;
        const replacements = replacementsByLayoutGroup[target.layoutGroup];
        const replacementIndex = Math.floor(
          target.layoutIndex * replacements.length / Math.max(1, target.layoutSize),
        );
        particle.replacement = replacements[Math.min(replacements.length - 1, replacementIndex)] || target;
        if (target.editGroup < 0 && Math.hypot(
          particle.replacement.x - target.x,
          particle.replacement.y - target.y,
        ) > 0.5) {
          unchangedLayoutShifts += 1;
        }
      }
      field.dataset.targetParticles = String(targetCount);
      field.dataset.unchangedLayoutShifts = String(unchangedLayoutShifts);
    };

    const rebuildParticles = () => {
      const particleCount = Math.round((width * height) / 165 * density);
      particles = Array.from({ length: particleCount }, (_, index) => makeParticle(index));
      assignSemanticTargets();
    };

    const resize = () => {
      const bounds = field.getBoundingClientRect();
      width = Math.max(1, bounds.width);
      height = Math.max(1, bounds.height);
      ratio = Math.min(window.devicePixelRatio || 1, 2);
      semanticLineCount = 2;
      field.dataset.semanticLines = String(semanticLineCount);
      const coherenceGeometry = geometry();
      field.dataset.coherenceSide = String(Math.round(coherenceGeometry.side));
      field.dataset.coherenceX = String(Math.round(coherenceGeometry.centerX));
      field.dataset.semanticCopy = 'LANGUAGE FORMS / TOKENS RESOLVE';
      field.dataset.semanticFontSize = String(semanticFontSize(coherenceGeometry.side, width < 700));
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      rebuildParticles();
    };

    const markInteraction = () => {
      field.dataset.interacting = 'true';
      window.clearTimeout(interactionTimer);
      interactionTimer = window.setTimeout(() => {
        field.dataset.interacting = 'false';
      }, 1100);
    };

    const updatePointer = (event: PointerEvent) => {
      const bounds = field.getBoundingClientRect();
      const nextX = event.clientX - bounds.left;
      const nextY = event.clientY - bounds.top;
      pointer.speed = Math.min(42, Math.hypot(nextX - pointer.x, nextY - pointer.y));
      pointer.previousX = pointer.x || nextX;
      pointer.previousY = pointer.y || nextY;
      pointer.x = nextX;
      pointer.y = nextY;
      pointer.active = true;
      pointer.energy = Math.min(1, pointer.energy + 0.22);
      markInteraction();
    };

    field.addEventListener('pointerenter', updatePointer);
    field.addEventListener('pointermove', updatePointer);
    field.addEventListener('pointerleave', () => {
      pointer.active = false;
      markInteraction();
    });

    const drawAmbientMaterial = (particle: Particle, x: number, y: number, alpha: number, driftX: number, driftY: number) => {
      const channels = particle.spectral ? '158, 173, 179' : particle.depth > 0.7 ? '232, 234, 226' : '184, 189, 182';
      const size = particle.size * (0.72 + particle.depth);
      if (particle.material === 'stroke') {
        const angle = Math.atan2(driftY, driftX);
        const length = 2.5 + particle.depth * 5;
        context.strokeStyle = `rgba(${channels}, ${alpha * 0.68})`;
        context.lineWidth = 0.35 + particle.depth * 0.2;
        context.beginPath();
        context.moveTo(x, y);
        context.lineTo(x + Math.cos(angle) * length, y + Math.sin(angle) * length);
        context.stroke();
        return;
      }
      if (particle.material === 'mask') {
        context.font = `${5.5 + particle.depth * 1.5}px ui-monospace, SFMono-Regular, Menlo, monospace`;
        context.fillStyle = `rgba(${channels}, ${alpha * 0.26})`;
        context.fillText(maskGlyphs[particle.index % maskGlyphs.length], x, y);
        return;
      }
      context.fillStyle = `rgba(${channels}, ${alpha})`;
      context.fillRect(x, y, size, size * 0.72);
    };

    const drawPointerGlyph = (particle: Particle, influence: number) => {
      if (influence < 0.18 || particle.index % 29 !== 0) return false;
      const stage = tokenStageForInfluence(influence);
      if (stage === 'noise') return false;
      const glyphs = stage === 'mask' ? maskGlyphs : stage === 'partial' ? partialGlyphs : resolvedGlyphs;
      context.font = `${stage === 'resolved' ? 9 : 7}px ui-monospace, SFMono-Regular, Menlo, monospace`;
      context.fillStyle = `rgba(232, 234, 226, ${Math.min(0.72, 0.18 + influence * 0.58)})`;
      context.fillText(glyphs[particle.index % glyphs.length], particle.x, particle.y);
      return true;
    };

    const drawPhaseEdges = (phase: CoherencePhase) => {
      if ((phase.name !== 'align' && phase.name !== 'fragment') || phase.coherence < 0.08) return;
      const { centerX, centerY, side } = geometry();
      const alpha = Math.min(0.16, phase.coherence * 0.16);
      context.strokeStyle = `rgba(158, 173, 179, ${alpha})`;
      context.lineWidth = 0.55;
      context.beginPath();
      context.moveTo(centerX - side / 2, centerY - side / 2 + 10);
      context.lineTo(centerX - side / 2, centerY - side / 2 + 28);
      context.moveTo(centerX + side / 2 - 22, centerY + side / 2);
      context.lineTo(centerX + side / 2 - 7, centerY + side / 2);
      context.stroke();
    };

    const updateState = (phase: CoherencePhase) => {
      field.dataset.coherenceState = phase.name === 'hold' || phase.name === 'resolved'
        ? 'resolved'
        : phase.name === 'fragment' || phase.name === 'reform'
          ? 'editing'
          : phase.name;
    };

    const renderFrame = (now: number, fixedPhase?: CoherencePhase) => {
      const delta = Math.min(2, (now - previousFrame) / 16.67);
      previousFrame = now;
      frameCount += 1;
      const phase = fixedPhase || coherencePhaseAt(now - cycleStarted);
      if (!fixedPhase) updateState(phase);
      const { centerX, centerY, side, feather } = geometry();

      context.globalCompositeOperation = 'source-over';
      context.fillStyle = fixedPhase ? '#030303' : 'rgba(3, 3, 3, 0.2)';
      context.fillRect(0, 0, width, height);

      pointer.energy += ((pointer.active ? 1 : 0) - pointer.energy) * 0.055;
      pointer.speed *= 0.9;
      const pointerRadius = Math.min(width, height) * (width < 700 ? 0.34 : 0.3);
      if (pointer.energy > 0.01) {
        const halo = context.createRadialGradient(pointer.x, pointer.y, 0, pointer.x, pointer.y, pointerRadius * 1.4);
        halo.addColorStop(0, `rgba(236, 239, 229, ${0.12 * pointer.energy})`);
        halo.addColorStop(0.35, `rgba(158, 173, 179, ${0.035 * pointer.energy})`);
        halo.addColorStop(1, 'rgba(0, 0, 0, 0)');
        context.fillStyle = halo;
        context.fillRect(pointer.x - pointerRadius * 1.5, pointer.y - pointerRadius * 1.5, pointerRadius * 3, pointerRadius * 3);
      }

      let targetError = 0;
      let targetSamples = 0;
      for (const particle of particles) {
        const driftX = Math.sin(now * 0.00018 + particle.seed) * (0.16 + particle.depth * 0.22);
        const driftY = Math.cos(now * 0.00015 + particle.seed * 1.7) * (0.11 + particle.depth * 0.16);
        const ambientX = particle.originX + driftX * 24;
        const ambientY = particle.originY + driftY * 22;
        let desiredX = ambientX;
        let desiredY = ambientY;
        let semanticStrength = 0;

        if (particle.target) {
          const localCoherence = coherenceWeight(particle.originX, particle.originY, centerX, centerY, side, feather);
          semanticStrength = phase.coherence * (
            phase.decode + (1 - phase.decode) * (0.48 + localCoherence * 0.52)
          );
          const replacement = particle.replacement || particle.target;
          let semanticX = particle.target.x + (replacement.x - particle.target.x) * phase.replacement;
          let semanticY = particle.target.y + (replacement.y - particle.target.y) * phase.replacement;
          if (particle.target.editGroup >= 0 && phase.edit > 0) {
            semanticX += Math.sin(particle.seed * 1.9) * phase.edit * (8 + particle.depth * 8);
            semanticY += Math.cos(particle.seed * 2.3) * phase.edit * (5 + particle.depth * 5);
          }
          const bandX = Math.max(centerX - side * 0.46, Math.min(centerX + side * 0.46, particle.originX));
          const orderedX = bandX + (semanticX - bandX) * phase.decode;
          const orderedY = semanticY;
          const resolved = resolveParticlePosition(
            { x: desiredX, y: desiredY },
            { x: orderedX, y: orderedY },
            semanticStrength,
          );
          desiredX = resolved.x;
          desiredY = resolved.y;
        }

        const pointerDx = pointer.x - particle.x;
        const pointerDy = pointer.y - particle.y;
        const pointerDistance = Math.hypot(pointerDx, pointerDy) || 1;
        const pointerInfluence = pointer.energy * Math.max(0, 1 - pointerDistance / pointerRadius);
        if (pointerInfluence > 0) {
          desiredX += pointerDx * pointerInfluence * 0.075;
          desiredY += pointerDy * pointerInfluence * 0.028;
        }

        if (semanticStrength > 0) {
          particle.x = desiredX;
          particle.y = desiredY;
        } else {
          particle.x += (desiredX - particle.x) * 0.055 * delta;
          particle.y += (desiredY - particle.y) * 0.055 * delta;
        }
        const semanticActive = Boolean(particle.target && phase.decode > 0.04 && semanticStrength > 0.05);
        const editing = Boolean(particle.target && particle.target.editGroup >= 0 && phase.edit > 0.04);
        const mobileCopyOcclusion = width < 700
          && particle.x < width * 0.84
          && particle.y > height * 0.43
          && particle.y < height * 0.76
          ? 0.25
          : 1;
        const alpha = Math.min(
          0.9,
          (0.045 + particle.depth * 0.12 + pointerInfluence * 0.34 + semanticStrength * 0.48) * mobileCopyOcclusion,
        );

        if (semanticActive) {
          const mineral = editing && particle.index % 4 === 0;
          context.fillStyle = mineral
            ? `rgba(197, 207, 162, ${Math.min(0.82, alpha)})`
            : `rgba(232, 234, 226, ${Math.min(0.86, alpha)})`;
          const semanticSize = 0.68 + particle.depth * 0.76;
          context.fillRect(particle.x, particle.y, semanticSize, semanticSize * 0.78);
        } else if (!drawPointerGlyph(particle, pointerInfluence) && (particle.material !== 'semantic' || phase.coherence > 0.08)) {
          drawAmbientMaterial(particle, particle.x, particle.y, alpha, driftX, driftY);
        }

        if (field.dataset.coherenceState === 'resolved' && particle.target) {
          const target = phase.replacement >= 1 ? (particle.replacement || particle.target) : particle.target;
          targetError += Math.hypot(particle.x - target.x, particle.y - target.y);
          targetSamples += 1;
        }

        if (pointerInfluence > 0.24 && pointer.speed > 3 && particle.index % 7 === 0) {
          context.strokeStyle = `rgba(225, 229, 221, ${pointerInfluence * Math.min(pointer.speed / 42, 1) * 0.07})`;
          context.lineWidth = 0.45;
          context.beginPath();
          context.moveTo(particle.x, particle.y);
          context.lineTo(
            particle.x - (pointer.x - pointer.previousX) * 0.55,
            particle.y - (pointer.y - pointer.previousY) * 0.55,
          );
          context.stroke();
        }
      }

      if (targetSamples > 0) {
        field.dataset.targetError = (targetError / targetSamples).toFixed(2);
      }

      drawPhaseEdges(phase);
      pointer.previousX += (pointer.x - pointer.previousX) * 0.24;
      pointer.previousY += (pointer.y - pointer.previousY) * 0.24;

      if (!fixedPhase && frameCount >= 120) {
        const fps = 120000 / Math.max(1, now - frameWindowStarted);
        const nextDensity = densityForFps(fps, density);
        if (nextDensity < density) {
          density = nextDensity;
          rebuildParticles();
        }
        frameCount = 0;
        frameWindowStarted = now;
      }
    };

    const draw = (now: number) => {
      frameHandle = 0;
      renderFrame(now);
      frameHandle = requestAnimationFrame(draw);
    };

    const stopAnimation = () => {
      if (frameHandle) cancelAnimationFrame(frameHandle);
      frameHandle = 0;
    };

    const startAnimation = () => {
      if (frameHandle || document.hidden || motionQuery.matches) return;
      frameHandle = requestAnimationFrame(draw);
    };

    const drawReducedSnapshot = () => {
      field.dataset.motion = 'reduced';
      field.dataset.coherenceState = 'partial';
      field.dataset.reducedTargets = field.dataset.targetParticles || '0';
      renderFrame(performance.now(), {
        name: 'decode',
        coherence: 0.82,
        decode: 0.68,
        edit: 0,
        replacement: 0,
        disperse: 0,
      });
    };

    const observer = new ResizeObserver(() => {
      resize();
      if (motionQuery.matches) drawReducedSnapshot();
    });
    observer.observe(field);
    resize();
    if (motionQuery.matches) {
      drawReducedSnapshot();
    } else {
      startAnimation();
    }

    motionQuery.addEventListener('change', (event) => {
      stopAnimation();
      if (event.matches) {
        drawReducedSnapshot();
      } else {
        field.dataset.motion = 'full';
        previousFrame = performance.now();
        cycleStarted = previousFrame;
        frameWindowStarted = previousFrame;
        startAnimation();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        hiddenAt = performance.now();
        stopAnimation();
      } else if (!motionQuery.matches) {
        const resumedAt = performance.now();
        cycleStarted += resumedAt - hiddenAt;
        previousFrame = resumedAt;
        frameWindowStarted = resumedAt;
        frameCount = 0;
        startAnimation();
      }
    });
  });
</script>

<style>
  .denoise-field {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 72% 50%, rgb(255 255 248 / 0.055), transparent 34%),
      #030303;
  }

  canvas {
    width: 100%;
    height: 100%;
  }

  .field-readout {
    position: absolute;
    right: 0;
    bottom: 1rem;
    left: 0;
    display: flex;
    justify-content: space-between;
    color: #4c4c48;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.55rem;
    letter-spacing: 0.14em;
  }

  @media (max-width: 700px) {
    .field-readout {
      display: none;
    }

  }
</style>

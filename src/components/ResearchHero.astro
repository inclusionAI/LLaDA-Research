---
import DenoiseField from './DenoiseField.astro';
import { withBase } from '../lib/site-config';

const base = import.meta.env.BASE_URL;
---

<section class="research-hero shell" aria-labelledby="hero-title">
  <DenoiseField />
  <div class="hero-copy">
    <p class="hero-kicker">LLaDA / Diffusion Language Models</p>
    <h1 id="hero-title">Language takes shape.</h1>
    <p class="hero-summary">We study how language and multimodal systems emerge through iterative diffusion and editing.</p>
    <div class="hero-links">
      <a href={withBase(base, 'papers/')} data-hero-cta>Read the publications <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .research-hero {
    --hero-ink: var(--ink);
    --hero-muted: var(--muted);
    position: relative;
    display: flex;
    align-items: center;
    height: clamp(24rem, 55vh, 42rem);
    overflow: hidden;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(38rem, 48%);
    padding-bottom: 0.5rem;
    pointer-events: none;
  }

  .hero-kicker {
    margin: 0 0 var(--space-2);
    color: var(--hero-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    line-height: var(--leading-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--hero-ink);
    font-size: var(--text-hero);
    font-weight: 400;
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
  }

  .hero-summary {
    max-width: 31rem;
    margin: var(--space-3) 0 0;
    color: var(--hero-muted);
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }

  .hero-links {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-3);
    pointer-events: auto;
  }

  .hero-links a {
    position: relative;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    min-height: var(--control-size);
    color: var(--hero-ink);
    font-size: var(--text-label);
    font-weight: 600;
    line-height: var(--leading-label);
    transition: color var(--motion-fast);
  }

  .hero-links a:hover,
  .hero-links a:focus-visible {
    color: var(--hero-ink);
  }

  .hero-links a span {
    display: inline-block;
    transition: transform var(--motion-fast);
  }

  .hero-links a:hover span,
  .hero-links a:focus-visible span {
    transform: translate(2px, -2px);
  }

  @media (max-width: 800px) {
    .research-hero {
      align-items: flex-end;
      height: clamp(22.5rem, 62svh, 32rem);
      padding-bottom: 3.2rem;
    }

    .hero-copy {
      width: 84%;
    }

    h1 {
      font-size: var(--text-hero-mobile);
    }

    .hero-summary {
      max-width: 18rem;
    }
  }
</style>

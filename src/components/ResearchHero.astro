---
import DenoiseField from './DenoiseField.astro';
import { withBase } from '../lib/site-config';

const base = import.meta.env.BASE_URL;
---

<section class="research-hero shell" aria-labelledby="hero-title">
  <DenoiseField />
  <div class="hero-copy">
    <p class="hero-kicker">LLaDA / Diffusion Language Models</p>
    <h1 id="hero-title">Language,<br />diffused.</h1>
    <p class="hero-summary">LLaDA turns masked noise into language through iterative, parallel denoising—an open alternative to left-to-right generation.</p>
    <div class="hero-links">
      <a href={withBase(base, 'models/')}>Explore the models <span aria-hidden="true">↗</span></a>
      <a href={withBase(base, 'papers/')}>Read the papers <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .research-hero {
    position: relative;
    display: flex;
    align-items: center;
    height: clamp(24rem, 55vh, 42rem);
    overflow: hidden;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(38rem, 48%);
    padding-bottom: 0.5rem;
    pointer-events: none;
  }

  .hero-kicker {
    margin: 0 0 1.15rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(3.4rem, 7.3vw, 7.4rem);
    font-weight: 430;
    line-height: 0.82;
    letter-spacing: -0.078em;
  }

  .hero-summary {
    max-width: 31rem;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: clamp(0.94rem, 1.25vw, 1.06rem);
    line-height: 1.6;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.65rem;
    pointer-events: auto;
  }

  .hero-links a {
    padding-bottom: 0.28rem;
    border-bottom: 1px solid transparent;
    color: var(--ink-soft);
    font-size: 0.75rem;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .hero-links a:hover,
  .hero-links a:focus-visible {
    border-color: var(--ink);
    color: var(--ink);
  }

  @media (max-width: 800px) {
    .research-hero {
      align-items: flex-end;
      height: clamp(22.5rem, 62svh, 32rem);
      padding-bottom: 3.2rem;
    }

    .hero-copy {
      width: 84%;
    }

    h1 {
      font-size: clamp(3.8rem, 17vw, 6rem);
    }

    .hero-summary {
      max-width: 18rem;
    }
  }
</style>

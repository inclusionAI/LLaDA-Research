---
import { withBase } from '../lib/site-config';
import HeroBackground from './HeroBackground.astro';

const base = import.meta.env.BASE_URL;
---

<section class="research-hero shell" aria-labelledby="hero-title">
  <HeroBackground />
  <div class="hero-copy">
    <p class="hero-kicker">LLaDA / Diffusion Language Models</p>
    <h1 id="hero-title">Beyond next-token prediction.</h1>
    <p class="hero-summary">LLaDA is a family of diffusion language models exploring how language and multimodal intelligence emerge through iterative denoising rather than autoregressive prediction.</p>
    <div class="hero-links">
      <a href={withBase(base, 'papers/')} data-hero-cta>
        <span class="hero-link-label">Read the publications</span>
        <span class="hero-link-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .research-hero {
    position: relative;
    display: flex;
    justify-content: center;
    padding-block: clamp(4rem, 12vh, 8rem) clamp(2.5rem, 6vh, 4rem);
    text-align: center;
    overflow: hidden;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    padding-inline: var(--space-2);
  }

  .hero-kicker {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    line-height: var(--leading-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-hero);
    font-weight: 500;
    line-height: var(--leading-page);
    letter-spacing: var(--tracking-title);
  }

  .hero-summary {
    max-width: 34rem;
    margin: var(--space-3) auto 0;
    color: var(--muted);
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }

  .hero-links {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .hero-links a {
    position: relative;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    min-height: var(--control-size);
    overflow: visible;
    color: var(--ink);
    font-size: var(--text-label);
    font-weight: 600;
    line-height: var(--leading-label);
    transition: color var(--motion-fast);
  }

  .hero-links a:hover,
  .hero-links a:focus-visible {
    color: var(--accent);
  }

  .hero-link-label {
    position: relative;
    z-index: 1;
    display: inline-block;
    overflow: visible;
    padding-block: 2px;
    line-height: 1.5;
  }

  .hero-link-arrow {
    display: inline-block;
    transition: transform var(--motion-fast);
  }

  .hero-links a:hover .hero-link-arrow,
  .hero-links a:focus-visible .hero-link-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 800px) {
    .research-hero {
      padding-block: 3rem 2rem;
    }

    h1 {
      font-size: var(--text-hero-mobile);
      line-height: 1.05;
    }

    .hero-summary {
      max-width: 24rem;
      margin-top: var(--space-2);
      line-height: 1.55;
    }

    .hero-links {
      margin-top: var(--space-2);
    }
  }
</style>

---
interface Props {
  citation?: string;
}

const { citation } = Astro.props;
---

{citation && (
  <section class="citation" data-citation>
    <div class="citation-header">
      <h2>Citation</h2>
      <button type="button" data-citation-copy data-citation-value={citation}>Copy citation</button>
    </div>
    <pre><code>{citation}</code></pre>
    <p class="copy-status" aria-live="polite" data-copy-status></p>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-citation]').forEach((section) => {
    const button = section.querySelector<HTMLButtonElement>('[data-citation-copy]');
    const status = section.querySelector<HTMLElement>('[data-copy-status]');
    button?.addEventListener('click', async () => {
      const citation = button.dataset.citationValue ?? '';
      try {
        await navigator.clipboard.writeText(citation);
        button.textContent = 'Copied';
        if (status) status.textContent = 'Citation copied to clipboard.';
        window.setTimeout(() => {
          button.textContent = 'Copy citation';
          if (status) status.textContent = '';
        }, 2000);
      } catch {
        if (status) status.textContent = 'Select the citation text and copy it manually.';
      }
    });
  });
</script>

<style>
  .citation {
    margin-top: var(--space-4);
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--surface);
  }

  .citation-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 500;
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  button {
    min-height: var(--control-size);
    padding: 0 var(--space-1);
    border: 0;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    font-size: var(--type-label);
    font-weight: 600;
    line-height: var(--leading-label);
  }

  pre {
    overflow-x: auto;
    margin: var(--space-1) 0 0;
    padding: var(--space-1);
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--surface-soft);
    color: var(--ink-soft);
    font-size: var(--text-label);
    line-height: var(--leading-small);
    white-space: pre-wrap;
  }

  .copy-status {
    margin: var(--space-1) 0 0;
    color: var(--ink);
    font-size: var(--type-meta);
    line-height: var(--leading-meta);
  }
</style>

---
interface ResourceMap {
  project?: string;
  paper?: string;
  pdf?: string;
  code?: string;
  model?: string;
  modelscope?: string;
}

interface Props {
  links?: ResourceMap;
  compact?: boolean;
}

const { links = {}, compact = false } = Astro.props;
const definitions: Array<[keyof ResourceMap, string]> = [
  ['project', 'Project'],
  ['paper', 'Paper'],
  ['pdf', 'PDF'],
  ['code', 'Code'],
  ['model', 'Models'],
  ['modelscope', 'ModelScope'],
];
const available = definitions.filter(([key]) => Boolean(links[key]));
---

{available.length > 0 && (
  <nav class:list={['resource-links', { compact }]} aria-label="External resources">
    {available.map(([key, label], index) => (
      <a class:list={['resource-link', { primary: !compact && index === 0 }]} href={links[key]} target="_blank" rel="noreferrer">
        <span>{label}</span><span class="external-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </nav>
)}

<style>
  .resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
  }

  .resource-link {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    min-height: var(--control-size);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    font-size: var(--type-label);
    font-weight: 600;
    line-height: var(--leading-label);
    transition: border-color var(--motion-fast), transform var(--motion-fast), background var(--motion-fast);
  }

  .resource-link:hover {
    border-color: var(--ink-soft);
    background: var(--surface);
    color: var(--ink);
    transform: translateY(-2px);
  }

  .resource-link.primary {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .compact .resource-link {
    min-height: var(--control-size);
    padding: 0 var(--space-1);
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--muted);
    font-size: var(--type-meta);
  }

  .compact .resource-link:hover {
    color: var(--ink);
    transform: none;
  }
</style>

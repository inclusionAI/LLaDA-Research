---
import { selectRelated } from '../lib/archive';
import { withBase } from '../lib/site-config';

type Kind = 'model' | 'paper' | 'blog';

interface Entry {
  id: string;
  kind: Kind;
  data: {
    title: string;
    summary: string;
    tags: string[];
    date: Date;
  };
}

interface Props {
  currentId: string;
  currentKind: Kind;
  entries: Entry[];
  tags: string[];
}

const { currentId, currentKind, entries, tags } = Astro.props;
const related = selectRelated(entries, { id: currentId, kind: currentKind }, tags);
const base = import.meta.env.BASE_URL;
const pathByKind: Record<Kind, string> = { model: 'models', paper: 'papers', blog: 'blog' };
---

{related.length > 0 && (
  <section class="related" aria-labelledby="related-title">
    <h2 id="related-title">Related</h2>
    <div class="related-grid">
      {related.map((entry) => (
        <a href={withBase(base, `${pathByKind[entry.kind]}/${entry.id}/`)}>
          <span>{entry.kind}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary}</p>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .related > h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-title-md);
    font-weight: 600;
    line-height: var(--leading-title-md);
    letter-spacing: var(--tracking-title);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .related-grid a {
    display: block;
    padding: 0;
    border: 0;
    text-decoration: none;
  }

  .related-grid span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--type-meta);
    font-weight: 500;
    line-height: var(--leading-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .related-grid h3 {
    margin: var(--space-1) 0 0;
    font-size: var(--text-title-sm);
    font-weight: 500;
    line-height: var(--leading-title-sm);
    letter-spacing: var(--tracking-title);
  }

  .related-grid p {
    margin: var(--space-1) 0 0;
    color: var(--muted);
    font-size: var(--type-small);
    line-height: var(--leading-small);
  }

  @media (max-width: 700px) {
    .related-grid {
      grid-template-columns: 1fr;
    }

    .related-grid a {
      border-right: 0;
    }
  }
</style>

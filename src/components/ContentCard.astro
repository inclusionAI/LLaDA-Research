---
import ResourceLinks from './ResourceLinks.astro';
import { resolveAssetUrl } from '../lib/site-config';

interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  tags: string[];
  meta?: string;
  cover?: string;
  links?: Record<string, string | undefined>;
}

const { href, title, summary, date, tags, meta = 'Research', cover, links } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const resolvedCover = cover ? resolveAssetUrl(import.meta.env.BASE_URL, cover) : undefined;
---

<article class="content-card" data-filter-card data-title={title.toLowerCase()} data-tags={JSON.stringify(tags.map((tag) => tag.toLowerCase()))}>
  {resolvedCover && (
    <div class="card-art" aria-hidden="true">
      <img src={resolvedCover} alt="" width="420" height="300" loading="lazy" />
    </div>
  )}
  <div class="card-copy">
    <div class="card-meta">
      <span>{meta}</span>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>
    <h2><a href={href}>{title}</a></h2>
    <p>{summary}</p>
    <div class="card-links">
      <ResourceLinks links={links} compact />
    </div>
  </div>
</article>

<style>
  .content-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    transition: border-color 180ms ease;
  }

  .content-card:first-child { border-top: 0; }

  .content-card:hover { border-color: var(--line-strong); }

  .card-art {
    position: relative;
    display: block;
    max-height: 13rem;
    margin-top: var(--space-3);
    background: var(--surface);
  }

  .card-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(var(--space-3), 3vw, var(--space-4)) 0;
  }

  .card-meta {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    color: var(--muted);
    font-size: var(--type-meta);
    font-family: var(--font-mono);
    font-weight: 500;
    line-height: var(--leading-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .card-meta span {
    color: var(--ink-soft);
  }

  h2 {
    max-width: 40ch;
    margin: var(--space-1) 0 var(--space-1);
    font-size: var(--text-title-md);
    font-weight: 500;
    line-height: var(--leading-title-md);
    letter-spacing: var(--tracking-title);
    overflow-wrap: break-word;
  }

  h2 a:hover {
    color: var(--accent);
  }

  h2 a {
    display: inline-flex;
    align-items: center;
    min-width: var(--control-size);
    min-height: var(--control-size);
  }

  p {
    max-width: 42rem;
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-size: var(--type-body);
    line-height: var(--leading-body);
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: center;
    margin-top: var(--space-1);
  }
</style>

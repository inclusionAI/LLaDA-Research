---
import ResourceLinks from './ResourceLinks.astro';
import { resolveAssetUrl } from '../lib/site-config';

interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  tags: string[];
  meta?: string;
  cover?: string;
  links?: Record<string, string | undefined>;
}

const { href, title, summary, date, tags, meta = 'Research', cover, links } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const resolvedCover = cover ? resolveAssetUrl(import.meta.env.BASE_URL, cover) : undefined;
const titleTokens = title
  .replace(/[^A-Za-z0-9.\- ]/g, ' ')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 5);
---

<article class="content-card" data-filter-card data-title={title.toLowerCase()} data-tags={JSON.stringify(tags.map((tag) => tag.toLowerCase()))}>
  <a class="card-art" href={href} aria-label={resolvedCover ? `Read ${title}` : undefined}>
    {resolvedCover ? (
      <img src={resolvedCover} alt="" width="420" height="300" loading="lazy" />
    ) : (
      <span class="token-art">
        <span class="token-seed">[MASK] → {titleTokens[0] ?? 'LLaDA'}</span>
        <span class="token-line">{titleTokens.slice(1).map((token) => <i>{token}</i>)}</span>
        <span class="token-index">{date.getFullYear()} / {String(date.getMonth() + 1).padStart(2, '0')}</span>
      </span>
    )}
  </a>
  <div class="card-copy">
    <div class="card-meta">
      <span>{meta}</span>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>
    <h2><a href={href}>{title}</a></h2>
    <p>{summary}</p>
    <ul class="tag-list" aria-label="Tags">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    <div class="card-footer">
      <a class="read-link" href={href}>Read more <span aria-hidden="true">→</span></a>
      <ResourceLinks links={links} compact />
    </div>
  </div>
</article>

<style>
  .content-card {
    display: grid;
    grid-template-columns: minmax(10rem, 0.3fr) minmax(0, 1fr);
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    transition: border-color 180ms ease;
  }

  .content-card:hover { border-color: var(--line-strong); }

  .card-art {
    position: relative;
    display: block;
    min-height: 13rem;
    background: var(--surface);
  }

  .card-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .token-art {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.25rem;
    overflow: hidden;
    border-right: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--font-mono);
  }

  .token-art::after {
    position: absolute;
    width: 8rem;
    height: 8rem;
    right: -3rem;
    bottom: -3rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    content: "";
    opacity: 0.45;
  }

  .token-art > * { position: relative; z-index: 1; }

  .token-seed {
    color: var(--ink-soft);
    font-size: 0.66rem;
  }

  .token-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .token-line i {
    padding: 0.18rem 0.3rem;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.53rem;
    font-style: normal;
  }

  .token-index {
    position: absolute;
    right: 0.8rem;
    bottom: 0.7rem;
    color: var(--muted);
    font-size: 0.48rem;
    letter-spacing: 0.12em;
  }

  .card-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.4rem, 3vw, 2.2rem);
  }

  .card-meta {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    color: var(--muted);
    font-size: var(--type-meta);
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-meta span {
    color: var(--ink-soft);
  }

  h2 {
    max-width: 28ch;
    margin: 0.85rem 0 0.65rem;
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.045em;
  }

  h2 a:hover {
    color: var(--accent-deep);
  }

  p {
    max-width: 42rem;
    margin: 0 0 1.2rem;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: 1.7;
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .read-link {
    color: var(--ink-soft);
    font-size: var(--type-label);
    font-weight: 600;
  }

  @media (max-width: 650px) {
    .content-card {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }

    .card-art {
      min-height: 5.5rem;
      height: 5.5rem;
      margin-top: 1.4rem;
    }

    .token-art {
      padding: 0.55rem;
    }

    .token-seed {
      font-size: 0.46rem;
    }

    .token-line,
    .token-index {
      display: none;
    }

    .card-copy {
      padding: 1.4rem 0 1.4rem 1rem;
    }
  }
</style>

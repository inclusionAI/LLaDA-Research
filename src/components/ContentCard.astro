---
import DiffusionMark from './DiffusionMark.astro';
import ResourceLinks from './ResourceLinks.astro';
import { resolveAssetUrl } from '../lib/site-config';

interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  tags: string[];
  meta?: string;
  cover?: string;
  links?: Record<string, string | undefined>;
}

const { href, title, summary, date, tags, meta = 'Research', cover, links } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const resolvedCover = cover ? resolveAssetUrl(import.meta.env.BASE_URL, cover) : undefined;
---

<article class="content-card" data-filter-card data-title={title.toLowerCase()} data-tags={JSON.stringify(tags.map((tag) => tag.toLowerCase()))}>
  <a class="card-art" href={href} aria-label={`Read ${title}`}>
    {resolvedCover ? <img src={resolvedCover} alt="" width="420" height="300" loading="lazy" /> : <DiffusionMark compact label="Abstract LLaDA diffusion field" />}
  </a>
  <div class="card-copy">
    <div class="card-meta">
      <span>{meta}</span>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>
    <h2><a href={href}>{title}</a></h2>
    <p>{summary}</p>
    <ul class="tag-list" aria-label="Tags">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    <div class="card-footer">
      <a class="read-link" href={href}>Read more <span aria-hidden="true">→</span></a>
      <ResourceLinks links={links} compact />
    </div>
  </div>
</article>

<style>
  .content-card {
    display: grid;
    grid-template-columns: minmax(10rem, 0.3fr) minmax(0, 1fr);
    overflow: hidden;
    border-top: 1px solid var(--line);
    background: transparent;
    transition: border-color 180ms ease;
  }

  .content-card:hover {
    border-color: var(--line-strong);
    border-color: var(--line-strong);
  }

  .card-art {
    min-height: 13rem;
    background: var(--night);
  }

  .card-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.4rem, 3vw, 2.2rem);
  }

  .card-meta {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.68rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-meta span {
    color: var(--ink-soft);
  }

  h2 {
    max-width: 28ch;
    margin: 0.85rem 0 0.65rem;
    font-size: clamp(1.35rem, 2.8vw, 2.1rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  h2 a:hover {
    color: var(--ink);
  }

  p {
    max-width: 42rem;
    margin: 0 0 1.2rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .read-link {
    color: var(--ink-soft);
    font-size: 0.73rem;
    font-weight: 720;
  }

  @media (max-width: 650px) {
    .content-card {
      grid-template-columns: 1fr;
    }

    .card-art {
      min-height: 11rem;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import ContentCard from '../../components/ContentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPublished } from '../../lib/content';
import { withBase } from '../../lib/site-config';

const entries = sortPublished(await getCollection('blog'), import.meta.env.DEV);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Notes" description="Release notes, engineering details, and perspectives on diffusion language and multimodal modeling.">
  <div class="archive-page shell">
    {entries.length > 0 ? (
      <div class="archive-list">
        {entries.map((entry) => (
          <ContentCard
            href={withBase(base, `blog/${entry.id}/`)}
            title={entry.data.title}
            summary={entry.data.summary}
            date={entry.data.date}
            tags={entry.data.tags}
            meta={`${entry.data.category}${entry.data.readingTime ? ` · ${entry.data.readingTime}` : ''}`}
            cover={entry.data.cover}
            links={entry.data.links}
          />
        ))}
      </div>
    ) : (
      <div class="notes-empty">
        <h1>Notes</h1>
        <p>Release notes, engineering details, and perspectives on diffusion language and multimodal modeling.</p>
        <p class="empty-hint">Notes are coming soon — this section will collect updates as the research program grows.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .notes-empty {
    padding-block: var(--space-6) var(--space-8);
  }

  h1 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-title-md);
    font-weight: 600;
    line-height: var(--leading-title-md);
    letter-spacing: var(--tracking-title);
  }

  .notes-empty > p {
    max-width: 48rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: var(--leading-body);
  }

  .empty-hint {
    margin-top: var(--space-2) !important;
  }
</style>

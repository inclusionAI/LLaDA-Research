---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchUpdates from '../components/ResearchUpdates.astro';
import ResearchHero from '../components/ResearchHero.astro';
import ResearchColumn from '../components/ResearchColumn.astro';
import { sortPublished } from '../lib/content';

const [models, papers, posts] = await Promise.all([
  getCollection('models'),
  getCollection('papers'),
  getCollection('blog'),
]);

const includeDrafts = import.meta.env.DEV;
const publishedModels = sortPublished(models, includeDrafts);
const publishedPapers = sortPublished(papers, includeDrafts);
const publishedPosts = sortPublished(posts, includeDrafts);
const researchUpdates = [
  ...publishedPapers.slice(0, 2).map((entry) => ({ ...entry, kind: 'paper' as const })),
  ...publishedModels
    .filter(({ data }) => data.status === 'released')
    .slice(0, 1)
    .map((entry) => ({ ...entry, kind: 'model' as const })),
  ...publishedPosts.slice(0, 1).map((entry) => ({ ...entry, kind: 'blog' as const })),
];
---

<BaseLayout>
  <ResearchHero />
  <ResearchUpdates entries={researchUpdates} />
  <section class="research-index shell" data-research-index aria-labelledby="research-index-title">
    <header class="index-header">
      <p class="index-eyebrow">Research program</p>
      <h2 id="research-index-title">Diffusion language models, from foundations to scale.</h2>
      <p class="index-description">Models, papers, and technical notes across the LLaDA research program.</p>
    </header>
    <div class="research-grid">
      <ResearchColumn
        kind="model"
        title="Models"
        description="Open checkpoints for language and multimodal generation."
        ctaLabel="Explore all models"
        href="models/"
        entries={publishedModels.slice(0, 3)}
      />
      <ResearchColumn
        kind="paper"
        title="Papers"
        description="Methods for scaling, accelerating, and extending diffusion language models."
        ctaLabel="Browse all papers"
        href="papers/"
        entries={publishedPapers.slice(0, 4)}
      />
      <ResearchColumn
        kind="blog"
        title="Blog"
        description="Release notes, implementation details, and research perspectives."
        ctaLabel="Read all notes"
        href="blog/"
        entries={publishedPosts.slice(0, 3)}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .research-index {
    padding-block: clamp(4.5rem, 6vw, 6rem) 1rem;
  }

  .index-header {
    max-width: 42rem;
    margin-bottom: clamp(2.75rem, 4.5vw, 4rem);
  }

  .index-eyebrow {
    margin: 0 0 0.85rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .index-header h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 450;
    letter-spacing: -0.055em;
  }

  .index-description {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(3rem, 4.5vw, 4rem);
  }

  @media (max-width: 900px) {
    .research-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .research-grid > :global(* + *) {
      margin-top: clamp(2rem, 9vw, 2.5rem);
      padding-top: clamp(2rem, 9vw, 2.5rem);
      border-top: 1px solid var(--line);
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedRelease from '../components/FeaturedRelease.astro';
import ResearchHero from '../components/ResearchHero.astro';
import ResearchColumn from '../components/ResearchColumn.astro';
import { selectFeatured, sortPublished } from '../lib/content';

const [models, papers, posts] = await Promise.all([
  getCollection('models'),
  getCollection('papers'),
  getCollection('blog'),
]);

const includeDrafts = import.meta.env.DEV;
const publishedModels = sortPublished(models, includeDrafts);
const publishedPapers = sortPublished(papers, includeDrafts);
const publishedPosts = sortPublished(posts, includeDrafts);
const featured = selectFeatured([
  ...publishedModels.map((entry) => ({ ...entry, kind: 'model' as const })),
  ...publishedPapers.map((entry) => ({ ...entry, kind: 'paper' as const })),
  ...publishedPosts.map((entry) => ({ ...entry, kind: 'blog' as const })),
]);
---

<BaseLayout>
  <ResearchHero />
  {featured && <FeaturedRelease entry={featured} />}
  <section class="research-index shell" data-research-index aria-labelledby="research-index-title">
    <header class="index-header">
      <h2 id="research-index-title">Research index</h2>
      <p>Models / Papers / Notes</p>
    </header>
    <div class="research-grid">
      <ResearchColumn kind="model" title="Models" href="models/" entries={publishedModels.slice(0, 3)} />
      <ResearchColumn kind="paper" title="Papers" href="papers/" entries={publishedPapers.slice(0, 3)} />
      <ResearchColumn kind="blog" title="Blog" href="blog/" entries={publishedPosts.slice(0, 3)} />
    </div>
  </section>
</BaseLayout>

<style>
  .research-index {
    padding-block: 1.8rem 1rem;
  }

  .index-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .index-header h2 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 480;
    letter-spacing: -0.04em;
  }

  .index-header > p {
    margin: 0;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
  }

  .research-grid > :global(* + *) {
    border-left: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .research-grid {
      grid-template-columns: 1fr;
      border-bottom: 0;
    }

    .research-grid > :global(* + *) {
      border-left: 0;
    }
  }

  @media (max-width: 700px) {
    .index-header {
      align-items: center;
    }
  }
</style>

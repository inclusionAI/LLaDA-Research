---
import { getCollection } from 'astro:content';
import ArchiveFilter from '../../components/ArchiveFilter.astro';
import ContentCard from '../../components/ContentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPublished } from '../../lib/content';
import { withBase } from '../../lib/site-config';

const entries = sortPublished(await getCollection('papers'), import.meta.env.DEV);
const tags = [...new Set(entries.flatMap(({ data }) => data.tags))].toSorted();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Publications" description="Publications and technical reports from the LLaDA research family.">
  <div class="archive-page shell">
    <header class="page-intro">
      <div><p class="eyebrow">Research archive</p><h1>Publications</h1></div>
      <p>Technical reports and publications on diffusion language modeling, acceleration, and multimodal intelligence.</p>
    </header>
    <ArchiveFilter tags={tags} total={entries.length} />
    <div class="archive-list">
      {entries.map((entry) => (
        <ContentCard
          href={withBase(base, `papers/${entry.id}/`)}
          title={entry.data.title}
          summary={entry.data.summary}
          date={entry.data.date}
          tags={entry.data.tags}
          meta={entry.data.venue ?? 'Paper'}
          cover={entry.data.cover}
          links={entry.data.links}
        />
      ))}
    </div>
  </div>
</BaseLayout>

---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CitationCopy from '../../components/CitationCopy.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { isEntryVisible } from '../../lib/content';

export async function getStaticPaths() {
  const entries = (await getCollection('papers')).filter(({ data }) => isEntryVisible(data.draft, import.meta.env.DEV));
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'papers'> }
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const [models, papers] = await Promise.all([
  getCollection('models', ({ data }) => isEntryVisible(data.draft, import.meta.env.DEV)),
  getCollection('papers', ({ data }) => isEntryVisible(data.draft, import.meta.env.DEV)),
]);
const relatedEntries = [
  ...models.map((item) => ({ ...item, kind: 'model' as const })),
  ...papers.map((item) => ({ ...item, kind: 'paper' as const })),
];
---

<ContentLayout {...entry.data}>
  <div slot="aside" class="resource-panel">
    <p>{entry.data.venue ?? 'Research paper'}</p>
    <ResourceLinks links={entry.data.links} />
    <CitationCopy citation={entry.data.citation} />
  </div>
  <Content />
  <RelatedContent slot="related" currentId={entry.id} currentKind="paper" entries={relatedEntries} tags={entry.data.tags} />
</ContentLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import DiffusionMark from '../components/DiffusionMark.astro';
import { withBase } from '../lib/site-config';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found" description="The requested LLaDA research page could not be found.">
  <section class="not-found shell">
    <div class="error-copy">
      <p class="eyebrow">Error 404</p>
      <h1>Page not found.</h1>
      <p>The research page may have moved, or the link may be incomplete. Continue from one of the indexes below.</p>
      <nav class="recovery" aria-label="Page recovery">
        <a class="button button-primary" href={withBase(base)}>Back to home</a>
        <a class="button button-ghost" href={withBase(base, 'models/')}>Models</a>
        <a class="button button-ghost" href={withBase(base, 'papers/')}>Papers</a>
        <a class="button button-ghost" href={withBase(base, 'blog/')}>Blog</a>
      </nav>
    </div>
    <DiffusionMark label="Lost signal in the LLaDA diffusion field" />
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.75fr);
    gap: 1rem;
    min-height: calc(100vh - var(--header-height) - 8.5rem);
    padding-block: 2rem;
  }

  .error-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 7vw, 5rem);
    border: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.075em;
  }

  .error-copy > p:not(.eyebrow) {
    max-width: 36rem;
    color: var(--muted);
    font-size: var(--type-body-lg);
    line-height: 1.7;
  }

  .recovery {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 800px) {
    .not-found {
      grid-template-columns: 1fr;
    }
  }
</style>

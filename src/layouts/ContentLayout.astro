---
import BaseLayout from './BaseLayout.astro';
import '../styles/content.css';

interface Props {
  title: string;
  summary: string;
  date: Date;
  updatedDate?: Date;
  tags?: string[];
  authors?: string[];
  participants?: string[];
}

const {
  title,
  summary,
  date,
  updatedDate,
  tags = [],
  authors = [],
  participants = [],
} = Astro.props;
const formatDate = (value: Date) => value.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={summary}>
  <article>
    <header class="content-header shell">
      <h1>{title}</h1>
      <p class="content-summary">{summary}</p>
      <div class="content-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updatedDate && <span>Updated {formatDate(updatedDate)}</span>}
        {authors.length > 0 && <span>{authors.join(', ')}</span>}
        {participants.length > 0 && <span>Research with {participants.join(', ')}</span>}
      </div>
    </header>
    <div class="content-body shell">
      <aside class="content-aside"><slot name="aside" /></aside>
      <div class="prose"><slot /></div>
      <div class="content-related"><slot name="related" /></div>
    </div>
  </article>
</BaseLayout>
